{#
  FOOTER PARTIAL
  --------------
  Same idea as navbar.njk: shared markup, filled in from locale.site
  (site.ar.json / site.en.json) so every future migrated page can reuse
  it instead of hand-copying a footer.
#}
<!-- FOOTER -->
{# data-pagefind-ignore (Phase 3): same reasoning as navbar.njk — keeps
   the repeated footer boilerplate out of every page's search index. #}
<footer class="pt-5" data-pagefind-ignore>
<div class="container">
  {# rowClass differs between languages in the original site too — the
     Arabic footer's row had "align-items-start", the English one
     didn't. Kept as data (site.*.json → footer.rowClass) rather than
     hardcoded here, so this partial still works correctly for either
     language without an {% if %} branch. #}
  <div class="{{ locale.site.footer.rowClass }}">
    <div class="col-md-6">
      <h6 class="mb-3">{{ locale.site.footer.brandName }}</h6>
      <p class="mb-1 small">{{ locale.site.footer.tagline }}</p>
    </div>
    <div class="col-md-6">
      <h6 class="mb-3">{{ locale.site.footer.followLabel }}</h6>
      {#
        aria-label on each (accessibility pass, Phase 3): these are
        icon-only links — bootstrap-icons are just a font glyph with no
        text a screen reader can read, so without a label each one was
        announced as a bare, unnamed link. Labels come from
        site.*.json's social.*Label fields (brand names, kept
        untranslated in both languages — standard practice, screen
        readers handle Latin-script brand names fine in an Arabic
        context).

        Neither of these two headings nor the icons below carry a
        Bootstrap text-white/text-light class anymore (round 3 of the
        Home redesign, common.css): footer used to be unconditionally
        dark, so forcing white text was harmless, but now that footer
        is theme-aware (light in light mode, dark in dark mode) a
        forced-white utility would make these invisible against the
        new light footer. Left to inherit footer/footer a's own
        theme-aware color instead.
      #}
      <div class="d-flex gap-3">
        <a href="{{ locale.site.social.twitter }}" target="_blank" rel="noopener" aria-label="{{ locale.site.social.twitterLabel }}"><i class="bi bi-twitter-x fs-5"></i></a>
        <a href="{{ locale.site.social.instagram }}" target="_blank" rel="noopener" aria-label="{{ locale.site.social.instagramLabel }}"><i class="bi bi-instagram fs-5"></i></a>
        <a href="{{ locale.site.social.linkedin }}" target="_blank" rel="noopener" aria-label="{{ locale.site.social.linkedinLabel }}"><i class="bi bi-linkedin fs-5"></i></a>
        <a href="{{ locale.site.social.tiktok }}" target="_blank" rel="noopener" aria-label="{{ locale.site.social.tiktokLabel }}"><i class="bi bi-tiktok fs-5"></i></a>
      </div>
    </div>
  </div>
  <div class="border-top border-secondary mt-4 pt-3 pb-4 small text-center">
    {#
      The footer year used to be filled in by JS in assets/common.js
      (document.getElementById('year').textContent = new Date()...).
      That script is unchanged and still runs client-side — this <span>
      just needs to exist with id="year" for it to find.
    #}
    © <span id="year"></span> {{ locale.site.footer.copyrightSuffix }}
  </div>
</div>
</footer>
