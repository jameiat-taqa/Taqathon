<!-- FOOTER -->
<footer class="pt-5">
<div class="container">
  <div class="{{ locale.site.footer.rowClass }}">
    <div class="col-md-6">
      <h6 class="mb-3 text-white">{{ locale.site.footer.brandName }}</h6>
      <p class="mb-1 small">{{ locale.site.footer.tagline }}</p>
    </div>
    <div class="col-md-6">
      <h6 class="mb-3 text-white">{{ locale.site.footer.followLabel }}</h6>
      <div class="d-flex gap-3">
        <a href="{{ locale.site.social.twitter }}" target="_blank" rel="noopener" class="text-light"><i class="bi bi-twitter-x fs-5"></i></a>
        <a href="{{ locale.site.social.instagram }}" target="_blank" rel="noopener" class="text-light"><i class="bi bi-instagram fs-5"></i></a>
        <a href="{{ locale.site.social.linkedin }}" target="_blank" rel="noopener" class="text-light"><i class="bi bi-linkedin fs-5"></i></a>
        <a href="{{ locale.site.social.tiktok }}" target="_blank" rel="noopener" class="text-light"><i class="bi bi-tiktok fs-5"></i></a>
      </div>
    </div>
  </div>
  <div class="border-top border-secondary mt-4 pt-3 pb-4 small text-center">
    © <span id="year"></span> {{ locale.site.footer.copyrightSuffix }}
  </div>
</div>
</footer>
