---
pagination:
  data: pages.submission-guidelines.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - SUBMISSION GUIDELINES PAGE (src/pages/submission-guidelines.njk)
  ---------------------------------------------------------------------------------
  This page exists to fill the original Phase 2 plan's "Structured
  Submissions" slot WITHOUT duplicating two pages that already cover
  adjacent ground: submissions.njk (the actual upload links) and
  rules.njk (detailed, real, non-placeholder judging/submission
  rules). So this is deliberately a short checklist + links to both,
  not a full requirements page of its own — see
  submission-guidelines.ar.json / .en.json's "_comment" for why this
  is flagged as an interpretation call, not just placeholder text.
  This redesign changes ONLY layout/visual treatment.

  VISUAL SYSTEM (Phase 3, editorial rollout, page 6 — see about.njk
  for the token-system rationale). Two cards, same white/surface card
  pattern as judges.njk, side by side on desktop since they're equally
  weighted (a checklist and a set of links), not sequential steps.
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.sg-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.sg-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.sg-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.sg-badge{ display:inline-flex; background:rgba(196,64,26,.1); color:var(--color-terra); border:1px solid rgba(196,64,26,.25); padding:.4rem .9rem; border-radius:999px; text-transform:uppercase; letter-spacing:.04em; font-size:.75rem; font-weight:700; margin-bottom:1rem; }
.sg-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0 0 .75rem; }
[dir="rtl"] .sg-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
.sg-hero-intro{ color:var(--color-dust); max-width:46ch; margin:0 auto; }
[data-bs-theme="dark"] .sg-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .sg-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }
[data-bs-theme="dark"] .sg-badge{ background:rgba(232,149,43,.12); color:var(--color-amber); border-color:rgba(232,149,43,.3); }
[data-bs-theme="dark"] .sg-hero-intro{ color:var(--muted); }

.sg-grid-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.sg-grid-section .container{ max-width:900px; }
.sg-card{
  background:#fff; border:1px solid rgba(0,40,76,.08); border-radius:1rem;
  padding:1.75rem; height:100%; box-shadow:0 6px 18px rgba(0,0,0,.04);
}
[data-bs-theme="dark"] .sg-card{ background:var(--surface); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.35); }
.sg-card-heading{ font-family:var(--font-display); font-weight:700; color:var(--brand-dark); font-size:1.3rem; margin-bottom:1.1rem; }
[dir="rtl"] .sg-card-heading{ font-family:'Tajawal', var(--font-display); font-weight:800; }
[data-bs-theme="dark"] .sg-card-heading{ color:var(--text); }
.sg-checklist{ list-style:none; padding:0; margin:0; color:var(--brand-dark); }
[data-bs-theme="dark"] .sg-checklist{ color:var(--text); }
.sg-checklist li{ display:flex; align-items:flex-start; gap:.6rem; margin-bottom:.75rem; }
.sg-checklist li:last-child{ margin-bottom:0; }
.sg-checklist .bi{ color:var(--color-terra); margin-top:.15rem; flex-shrink:0; }
[data-bs-theme="dark"] .sg-checklist .bi{ color:var(--color-amber); }
.sg-link-btn{
  border:1px solid rgba(0,40,76,.2); color:var(--brand-dark); border-radius:999px;
  font-weight:600; background:transparent;
}
.sg-link-btn:hover{ background:rgba(0,40,76,.05); color:var(--brand-dark); }
[data-bs-theme="dark"] .sg-link-btn{ border-color:rgba(255,255,255,.2); color:var(--text); }
[data-bs-theme="dark"] .sg-link-btn:hover{ background:rgba(255,255,255,.06); color:var(--text); }
{% endblock %}

{% block content %}

<section class="sg-hero">
<div class="container">
  <span class="sg-badge"><i class="bi {{ locale.content.hero.icon }}"></i> {{ locale.content.hero.kicker }}</span>
  <h1 class="sg-display">{{ locale.content.hero.heading }}</h1>
  <p class="sg-hero-intro">{{ locale.content.hero.intro }}</p>
</div>
</section>

<section class="sg-grid-section">
<div class="container">
  <div class="row g-4">
    <div class="col-md-6">
      <div class="sg-card">
        <h2 class="sg-card-heading">{{ locale.content.checklistHeading }}</h2>
        <ul class="sg-checklist">
          {% for item in locale.content.checklist %}
          <li><i class="bi bi-check-circle-fill"></i> {{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="col-md-6">
      <div class="sg-card">
        <h2 class="sg-card-heading">{{ locale.content.linksHeading }}</h2>
        <div class="d-flex flex-wrap gap-2">
          {% for link in locale.content.links %}
          <a class="btn sg-link-btn" href="{{ link.href }}">
            <i class="bi {{ link.icon }} me-1"></i>{{ link.label }}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
</section>

{% endblock %}
