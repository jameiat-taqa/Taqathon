---
pagination:
  data: pages.registration.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - REGISTRATION PAGE TEMPLATE (src/pages/registration.njk)
  -----------------------------------------------------------------------
  Deliberately copies src/pages/submissions.njk's exact pattern: one
  card per track, each a real external Google Form (not an embedded/
  custom form), with an "Open" button + a "copy link" button + a note
  showing the raw URL + a <noscript> fallback. Registering for
  Taqathon works the same way submitting a project does — a form this
  site links out to, not one it hosts — so this page reuses that
  pattern rather than inventing a different UI for the same idea.

  PLACEHOLDER CONTENT (as of Phase 2, 2026-08-11): the track names and
  every form's link are stand-ins — see registration.ar.json /
  registration.en.json's "_comment" field. locale.content.placeholderNote
  renders a visible on-page note about this for exactly that reason:
  so this doesn't quietly look "done" before the real tracks/links
  arrive. Remove that note (and this whole comment block) once real
  content replaces the placeholders.

  TO CUSTOMIZE:
    - Add/remove a track's card → edit the "forms" array in the copy
      JSON files, same as Submissions.
    - Wording → same copy JSON files, NOT this file.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.card-lite{ padding:0; }
.card-body{ padding:1.75rem 2rem; }
@media (max-width:767.98px){ .card-body{ padding:1.25rem 1.5rem; } }

.alert-info{
  background:linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
  border:1px solid #b8daff;
  border-inline-start:4px solid var(--brand-blue);
  color:#004085;
  border-radius:.75rem;
}
.alert-info a{ color:var(--brand-blue); font-weight:600; }

.alert-placeholder{
  background:linear-gradient(135deg, #fff8e1 0%, #fffdf5 100%);
  border:1px solid #ffe08a;
  border-inline-start:4px solid #f5a623;
  color:#7a5b00;
  border-radius:.75rem;
}
{% endblock %}

{% block content %}
<main class="py-5">
  <div class="container" style="max-width:980px;">
    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3"><i class="bi {{ locale.content.hero.icon }}"></i></div>
      <h5 class="mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h5>
      <p class="text-secondary mb-0">{{ locale.content.deadlineNote }}</p>
    </div>

    {% if locale.content.placeholderNote %}
    <div class="alert alert-placeholder fs-6 p-3 mb-4 d-flex align-items-start gap-3">
      <i class="bi bi-exclamation-triangle fs-5 mt-1 flex-shrink-0" style="color:#f5a623;"></i>
      <div>{{ locale.content.placeholderNote }}</div>
    </div>
    {% endif %}

    {% for form in locale.content.forms %}
    <div class="card card-lite rounded-2xl shadow-soft{% if not loop.first %} mt-4{% endif %}">
      <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
          <h5 class="mb-0 fw-semibold">{{ form.cardTitle }}</h5>
          <div class="d-flex gap-2">
            <a class="btn btn-brand btn-lg" target="_blank" rel="noopener"
               href="{{ form.openHref }}" aria-label="{{ form.openAriaLabel }}">
              <i class="bi {{ form.openIcon }} {{ locale.content.iconMarginClass }}"></i> {{ form.openLabel }}
            </a>
            <button type="button" class="btn btn-outline-secondary btn-lg js-copy-link" data-url="{{ form.openHref }}" aria-label="{{ form.copyAriaLabel }}">
              {{ locale.content.copyButtonLabel }}
            </button>
          </div>
        </div>

        <div class="alert alert-info fs-6 p-4 mb-0 d-flex align-items-start gap-3">
          <i class="bi bi-info-circle fs-5 mt-1 flex-shrink-0" style="color:var(--brand-blue);"></i>
          <div>
            <strong class="d-block mb-1">{{ locale.content.noteLabel }}</strong>
            {{ locale.content.noteBodyPrefix }}
            <span class="text-break d-inline-block mt-1" dir="ltr">{{ form.openHref }}</span>
          </div>
        </div>

        <noscript>
          <p class="mt-2">{{ form.noscriptText }}
            <a href="{{ form.openHref }}" target="_blank" rel="noopener" dir="ltr">{{ form.openHref }}</a>
          </p>
        </noscript>
      </div>
    </div>
    {% endfor %}
  </div>
</main>
{% endblock %}

{% block pageScript %}
{#
  Identical shared copy-link handler to submissions.njk's — duplicated
  rather than factored into assets/common.js since it's only two small
  pages so far; worth revisiting if a third page needs this same
  "copy a form link" button.
#}
document.querySelectorAll('.js-copy-link').forEach(function(btn){
  btn.addEventListener('click', async function(){
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      var original = btn.textContent;
      btn.textContent = '{{ locale.content.copiedLabel | safe }}';
      setTimeout(function(){ btn.textContent = original; }, 1200);
    } catch (e) {
      alert('{{ locale.content.copyErrorMsg | safe }}');
    }
  });
});
{% endblock %}
