---
pagination:
  data: pages.registration.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - REGISTRATION PAGE TEMPLATE (src/pages/registration.njk)
  -----------------------------------------------------------------------
  Deliberately copies src/pages/submissions.njk's exact pattern: one
  card per track, each a real external Google Form (not an embedded/
  custom form), with an "Open" button + a "copy link" button + a note
  showing the raw URL + a <noscript> fallback. Registering for
  Taqathon works the same way submitting a project does — a form this
  site links out to, not one it hosts — so this page reuses that
  pattern rather than inventing a different UI for the same idea.

  PLACEHOLDER CONTENT (still true after this redesign): the track
  names and every form's link are stand-ins — see
  registration.*.json's "_comment" field. locale.content.placeholderNote
  renders a visible on-page note about this for exactly that reason.
  This redesign upgrades that note from a plain alert box to the same
  dashed-border "pending confirmation" flag About's Official Status
  section introduced (.ed-draft-flag) — same content-authenticity
  signal, now expressed consistently across the site instead of each
  page inventing its own placeholder-warning styling.

  VISUAL SYSTEM (Phase 3, editorial rollout, page 15 — see about.njk
  for the token-system rationale).

  TO CUSTOMIZE:
    - Add/remove a track's card → edit the "forms" array in the copy
      JSON files, same as Submissions.
    - Wording → same copy JSON files, NOT this file.
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.rg-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.rg-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.rg-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.rg-badge{ display:inline-flex; background:rgba(196,64,26,.1); color:var(--color-terra); border:1px solid rgba(196,64,26,.25); padding:.4rem .9rem; border-radius:999px; text-transform:uppercase; letter-spacing:.04em; font-size:.75rem; font-weight:700; margin-bottom:1rem; }
.rg-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0 0 .5rem; }
[dir="rtl"] .rg-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
.rg-deadline{ color:var(--color-dust); }
[data-bs-theme="dark"] .rg-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .rg-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }
[data-bs-theme="dark"] .rg-badge{ background:rgba(232,149,43,.12); color:var(--color-amber); border-color:rgba(232,149,43,.3); }
[data-bs-theme="dark"] .rg-deadline{ color:var(--muted); }

.rg-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.rg-section .container{ max-width:820px; }

.ed-draft-flag{
  border:1.5px dashed rgba(196,64,26,.4); border-radius:.75rem;
  padding:1.1rem 1.25rem; margin-bottom:1.5rem; background:rgba(196,64,26,.04);
  display:flex; align-items:flex-start; gap:.75rem; color:var(--brand-dark);
}
.ed-draft-flag .bi{ color:var(--color-terra); flex-shrink:0; margin-top:.15rem; }
[data-bs-theme="dark"] .ed-draft-flag{ border-color:rgba(232,149,43,.4); background:rgba(232,149,43,.06); color:var(--text); }
[data-bs-theme="dark"] .ed-draft-flag .bi{ color:var(--color-amber); }

.rg-card{
  background:#fff; border:1px solid rgba(0,40,76,.08); border-radius:1rem;
  padding:1.75rem 2rem; box-shadow:0 6px 18px rgba(0,0,0,.04); margin-bottom:1.5rem;
}
.rg-card:last-child{ margin-bottom:0; }
[data-bs-theme="dark"] .rg-card{ background:var(--surface); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.35); }
.rg-card-title{ font-family:var(--font-display); font-weight:700; color:var(--brand-dark); font-size:1.3rem; margin:0; }
[dir="rtl"] .rg-card-title{ font-family:'Tajawal', var(--font-display); font-weight:800; }
[data-bs-theme="dark"] .rg-card-title{ color:var(--text); }
.rg-open-btn{ background:var(--color-amber); border:0; color:var(--brand-dark); font-weight:700; }
.rg-open-btn:hover{ filter:brightness(1.05); color:var(--brand-dark); }
.rg-copy-btn{ border:1px solid rgba(0,40,76,.2); color:var(--brand-dark); background:transparent; }
.rg-copy-btn:hover{ background:rgba(0,40,76,.05); color:var(--brand-dark); }
[data-bs-theme="dark"] .rg-copy-btn{ border-color:rgba(255,255,255,.2); color:var(--text); }
[data-bs-theme="dark"] .rg-copy-btn:hover{ background:rgba(255,255,255,.06); color:var(--text); }
.ed-note{
  background:rgba(196,64,26,.05); border:1px solid rgba(196,64,26,.15); border-radius:.75rem;
  padding:1rem 1.25rem; display:flex; align-items:flex-start; gap:.75rem; color:var(--brand-dark);
}
.ed-note .bi{ color:var(--color-terra); flex-shrink:0; margin-top:.15rem; }
[data-bs-theme="dark"] .ed-note{ background:rgba(232,149,43,.06); border-color:rgba(232,149,43,.2); color:var(--text); }
[data-bs-theme="dark"] .ed-note .bi{ color:var(--color-amber); }
{% endblock %}

{% block content %}

<section class="rg-hero">
<div class="container">
  <span class="rg-badge"><i class="bi {{ locale.content.hero.icon }}"></i> {{ locale.content.hero.kicker }}</span>
  <h1 class="rg-display">{{ locale.content.hero.heading }}</h1>
  <p class="rg-deadline mb-0">{{ locale.content.deadlineNote }}</p>
</div>
</section>

<section class="rg-section">
<div class="container">

  {% if locale.content.placeholderNote %}
  <div class="ed-draft-flag">
    <i class="bi bi-flag-fill"></i>
    <div>{{ locale.content.placeholderNote }}</div>
  </div>
  {% endif %}

  {% for form in locale.content.forms %}
  <div class="rg-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
      <h2 class="rg-card-title">{{ form.cardTitle }}</h2>
      <div class="d-flex gap-2">
        <a class="btn rg-open-btn" target="_blank" rel="noopener"
           href="{{ form.openHref }}" aria-label="{{ form.openAriaLabel }}">
          <i class="bi {{ form.openIcon }} {{ locale.content.iconMarginClass }}"></i> {{ form.openLabel }}
        </a>
        <button type="button" class="btn rg-copy-btn js-copy-link" data-url="{{ form.openHref }}" aria-label="{{ form.copyAriaLabel }}">
          {{ locale.content.copyButtonLabel }}
        </button>
      </div>
    </div>

    <div class="ed-note">
      <i class="bi bi-info-circle-fill"></i>
      <div>
        <strong class="d-block mb-1">{{ locale.content.noteLabel }}</strong>
        {{ locale.content.noteBodyPrefix }}
        <span class="text-break d-inline-block mt-1" dir="ltr">{{ form.openHref }}</span>
      </div>
    </div>

    <noscript>
      <p class="mt-2">{{ form.noscriptText }}
        <a href="{{ form.openHref }}" target="_blank" rel="noopener" dir="ltr">{{ form.openHref }}</a>
      </p>
    </noscript>
  </div>
  {% endfor %}
</div>
</section>

{% endblock %}

{% block pageScript %}
document.querySelectorAll('.js-copy-link').forEach(function(btn){
  btn.addEventListener('click', async function(){
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      var original = btn.textContent;
      btn.textContent = '{{ locale.content.copiedLabel | safe }}';
      setTimeout(function(){ btn.textContent = original; }, 1200);
    } catch (e) {
      alert('{{ locale.content.copyErrorMsg | safe }}');
    }
  });
});
{% endblock %}
