  </div>

  <script>
    /**
     * Certificate Verification System
     *
     * How it works:
     * 1. User enters certificate ID in the search form
     * 2. System looks up ID in CERTIFICATES registry
     * 3. If found, displays certificate with all details
     * 4. If not found, shows error message
     *
     * Certificate Data Structure:
     * - Key: Certificate ID (must match exactly as printed)
     * - Value: Object containing:
     *   - arName: Arabic name
     *   - enName: English name
     *   - roleAr: Arabic role description
     *   - roleEn: English role description
     *   - type: Certificate type (judge, participant, winner, etc.)
     *   - eventAr: Event name in Arabic
     *   - eventEn: Event name in English
     *   - issueDateAr: Issue date in Arabic
     *   - issueDateEn: Issue date in English
     *   - periodAr: Period description in Arabic
     *   - periodEn: Period description in English
     *
     * To add certificates:
     * 1. Add new entry to CERTIFICATES object below
     * 2. Use certificate ID as the key
     * 3. Fill in all required metadata fields
     */

    // -------------------------------
    // Certificate Registry
    // -------------------------------
    // Add all certificates here using certificate ID as the key
    const CERTIFICATES = {
  // طاقَثون 2025 — شهادات المحكّمين الرسميّة

  "TAQ-2025-J-001": {
    arName: "د. أحلام سعود الثبيتي",
    enName: "Dr. Ahlam Saud Althubaity",
    roleAr: "خبيرة محكّمة في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },

  "TAQ-2025-J-002": {
    arName: "د. مها عبدالجبار ظفر",
    enName: "Dr. Maha Abduljabbar Dhafer",
    roleAr: "خبيرة محكّمة في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },

  "TAQ-2025-J-003": {
    arName: "د. عهود سعود الثبيتي",
    enName: "Dr. Ohoud Saud Althubaity",
    roleAr: "خبيرة محكّمة في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },

  "TAQ-2025-J-004": {
    arName: "م. علي حسن الغبيشي",
    enName: "Eng. Ali Hassan Alghubaishi",
    roleAr: "خبير محكّم في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },

  "TAQ-2025-J-005": {
    arName: "م. فريد زروال",
    enName: "Eng. Farid Zarwal",
    roleAr: "خبير محكّم في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },

  "TAQ-2025-J-006": {
    arName: "د. هيثم محمد رضوي",
    enName: "Dr. Haitham Mohammed Radwi",
    roleAr: "خبير محكّم في طاقَثون 2025",
    roleEn: "Expert Judge at Taqathon 2025",
    type: "judge",
    eventAr: "طاقَثون الطاقة 2025",
    eventEn: "Taqathon 2025 – Energy Hackathon",
    issueDateAr: "5 ديسمبر 2025",
    issueDateEn: "5 December 2025",
    periodAr: "خلال الفترة من 30 أغسطس إلى 2 ديسمبر 2025",
    periodEn: "during the period 30 August – 2 December 2025",
  },
};


    /**
     * Helper function to read URL query parameters
     * @param {string} name - Parameter name to retrieve
     * @returns {string|null} - Parameter value or null if not found
     *
     * Usage: Allows pre-filling certificate ID from URL (e.g., ?id=TAQ-2025-J-001)
     */
    function getQueryParam(name) {
      const url = new URL(window.location.href);
      return url.searchParams.get(name);
    }

    const certInput = document.getElementById("certId");
    const checkBtn = document.getElementById("checkBtn");
    const resultContainer = document.getElementById("resultContainer");
    const resultTitle = document.getElementById("resultTitle");
    const resultMeta = document.getElementById("resultMeta");
    const resultBody = document.getElementById("resultBody");
    const resultEnglishNote = document.getElementById("resultEnglishNote");
    const statusPill = document.getElementById("status-pill");
    const statusText = document.getElementById("status-text");

    /**
     * Updates the status indicator with appropriate styling
     * @param {string} type - Status type: "valid", "invalid", or "missing"
     * @param {string} message - Status message to display
     */
    function setStatus(type, message) {
      statusPill.classList.remove("status-valid", "status-invalid", "status-missing");

      if (type === "valid") {
        statusPill.classList.add("status-valid");      // Green for valid certificate
      } else if (type === "invalid") {
        statusPill.classList.add("status-invalid");    // Red for invalid/not found
      } else {
        statusPill.classList.add("status-missing");    // Yellow for missing input
      }

      statusText.textContent = message;
    }

    /**
     * Displays certificate verification result
     * @param {string} certId - Certificate ID that was searched
     * @param {object|null} cert - Certificate data object or null if not found
     */
    function showResult(certId, cert) {
      resultContainer.style.display = "block";

      if (!cert) {
        // Certificate not found - show error message
        resultTitle.textContent = "لم يتم العثور على الشهادة";
        resultMeta.innerHTML = `<span>رقم الشهادة: ${certId}</span>`;
        resultBody.innerHTML =
          "لم نتمكّن من العثور على شهادة مطابقة لرقم الشهادة المدخَل. الرجاء التأكد من الرقم كما يظهر في الشهادة، أو التواصل مع الجمعية للتحقق يدويًا.";
        resultEnglishNote.textContent =
          "No certificate found for the provided ID. Please verify the certificate number or contact the Association for manual verification.";
        setStatus("invalid", "الشهادة غير موجودة في السجل");
        return;
      }

      // Valid certificate found - display certificate details
      resultTitle.textContent = `الشهادة صالحة وصادرة عن جمعية الطاقة للتنمية المستدامة`;

      resultMeta.innerHTML = `رقم الشهادة: ${certId} • نوع الشهادة: ${cert.type === "judge" ? "شهادة خبرة" : "شهادة"} • تاريخ الإصدار: ${cert.issueDateAr}`;

      // Display certificate information in Arabic
      resultBody.innerHTML = `
        تُؤكّد جمعية الطاقة للتنمية المستدامة أن:
        <br />
        <b>${cert.arName}</b>
        <br />
        قد شارك/شاركت بصفة <b>${cert.roleAr}</b> ضمن
        <b>${cert.eventAr}</b>، وذلك ${cert.periodAr}.
      `;

      // Display certificate information in English
      resultEnglishNote.innerHTML = `
        This is to certify that <b>${cert.enName}</b> has served as
        <b>${cert.roleEn}</b> in <b>${cert.eventEn}</b>, ${cert.periodEn}.
        <br />
        Issued by the Energy Association for Sustainable Development on ${cert.issueDateEn}.
      `;

      setStatus("valid", "الشهادة صالحة ✅");
    }

    /**
     * Handles certificate verification when form is submitted
     * - Gets certificate ID from input
     * - Normalizes to uppercase for lookup
     * - Searches CERTIFICATES registry
     * - Displays result
     */
    function handleCheck() {
      const raw = certInput.value.trim();
      if (!raw) {
        setStatus("missing", "الرجاء إدخال رقم الشهادة");
        resultContainer.style.display = "none";
        return;
      }

      // Normalize to uppercase for case-insensitive lookup
      // Note: Certificate IDs in registry should be uppercase
      const certId = raw.toUpperCase();
      const cert = CERTIFICATES[certId];
      showResult(certId, cert);
    }

    // Event listeners for form submission
    checkBtn.addEventListener("click", handleCheck);  // Button click
    certInput.addEventListener("keydown", (e) => {    // Enter key press
      if (e.key === "Enter") {
        e.preventDefault();
        handleCheck();
      }
    });

    // Auto-check if certificate ID is provided in URL query parameter
    // Allows direct linking to specific certificates (e.g., verify.html?id=TAQ-2025-J-001)
    const initialId = getQueryParam("id");
    if (initialId) {
      certInput.value = initialId;
      handleCheck();  // Automatically verify on page load
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
