---
pagination:
  data: pages.gallery.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - GALLERY PAGE TEMPLATE (src/pages/gallery.njk)
  -----------------------------------------------------------
  Unlike every other migrated page, almost nothing here is rendered by
  Nunjucks at build time — the actual photo grid is built entirely by
  client-side JavaScript in pageScript below, which fetches gallery.json
  at runtime and renders image cards + a "load more" button + a
  lightbox modal. This template's job is mostly just providing the
  page shell and handing that script the handful of translated strings
  it needs (button labels, alt text, the error message).

  TO CUSTOMIZE:
    - Text/labels → src/_data/copy/gallery.ar.json / gallery.en.json.
    - Which images appear → gallery.json at the repo root (unchanged by
      this migration — still a flat array of filenames in assets/gallery/).
    - Batch size → the BATCH constant in pageScript below (still 24,
      same as the original).
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
/* ===== GALLERY ===== */
.gallery-card{
border:none;
border-radius:1rem;
overflow:hidden;
background:#fff;
box-shadow:0 10px 30px rgba(15,23,42,.08);
transition:transform .12s ease, box-shadow .12s ease;
height:100%;
}
.gallery-card:hover{
transform:translateY(-4px);
box-shadow:0 14px 40px rgba(15,23,42,.16);
}

.gallery-img-wrapper{
position:relative;
overflow:hidden;
aspect-ratio:4/3;
background:#000;
}

.gallery-img-wrapper img{
width:100%;
height:100%;
object-fit:cover;
transition:.3s ease;
}
.gallery-card:hover img{ transform:scale(1.05); }

{#
  The original pages mirrored this button's corner manually — Arabic
  put it bottom-left, English bottom-right. Both were really aiming
  for the same "trailing" corner, which is exactly what the logical
  property inset-inline-end means: it resolves to the left in RTL and
  the right in LTR automatically, so one rule replaces two mirrored
  ones. Same trick used for the back-to-top button below. (There WAS
  also a .gallery-badge rule in the original CSS, positioned the same
  mirrored way — dropped entirely here since no element anywhere in
  the gallery card markup actually has that class, in either language.)
#}
.gallery-zoom-icon{
position:absolute;
bottom:.9rem; inset-inline-end:.9rem;
width:2rem; height:2rem;
border-radius:50%;
background:rgba(0,0,0,.7);
color:#fff;
display:flex;
justify-content:center;
align-items:center;
border:none;
}

/* ===== LOAD MORE BUTTON ===== */
#loadMoreBtn{
background:var(--brand-blue);
color:#fff;
border:none;
border-radius:.5rem;
padding:.5rem 1.5rem;
font-weight:500;
transition:background .2s ease, transform .2s ease, box-shadow .2s ease;
box-shadow:0 2px 8px rgba(0,125,253,.2);
}
{#
  Accessibility pass (Phase 3): color:#fff here used to pair with this
  green background at a measured 2.16:1 contrast ratio — badly below
  WCAG AA's 4.5:1 text minimum. Swapped to brand-dark (6.91:1) rather
  than changing the background, for the same reasoning as
  schedule.njk's .btn-join:hover — see PROGRESS.md.
#}
#loadMoreBtn:hover:not(:disabled){
background:var(--brand-green);
transform:translateY(-1px);
box-shadow:0 4px 12px rgba(9,200,153,.3);
color:var(--brand-dark);
}
#loadMoreBtn:active:not(:disabled){
transform:translateY(0);
}
#loadMoreBtn:disabled{
background:var(--muted);
cursor:not-allowed;
opacity:.7;
box-shadow:none;
}

/* ===== BACK TO TOP BUTTON ===== */
.back-to-top{
position:fixed;
bottom:2rem;
inset-inline-end:2rem;
width:3rem;
height:3rem;
border-radius:50%;
background:var(--brand-blue);
color:#fff;
border:none;
display:flex;
align-items:center;
justify-content:center;
font-size:1.25rem;
box-shadow:0 4px 12px rgba(0,125,253,.3);
cursor:pointer;
opacity:0;
visibility:hidden;
transition:opacity .3s ease, visibility .3s ease, transform .2s ease, background .2s ease;
z-index:9999;
pointer-events:none;
}
.back-to-top.show{
opacity:1;
visibility:visible;
pointer-events:auto;
}
{#
  Accessibility pass (Phase 3): this is an icon-only button, so WCAG's
  non-text-contrast rule (3:1, not the 4.5:1 that applies to text)
  still applies to the arrow icon's color against its background. The
  previous white icon measured 2.16:1 against --brand-green — fails
  even that lower bar. Same brand-dark swap as the other green-hover
  states on this page/site — see PROGRESS.md.
#}
.back-to-top:hover{
background:var(--brand-green);
color:var(--brand-dark);
transform:translateY(-2px);
box-shadow:0 6px 16px rgba(9,200,153,.4);
}
.back-to-top:active{
transform:translateY(0);
}
@media (max-width:575.98px){
.back-to-top{
  bottom:1.5rem;
  inset-inline-end:1.5rem;
  width:2.75rem;
  height:2.75rem;
  font-size:1.1rem;
}
}

.modal-content .btn-close {
z-index: 5;
}
{#
  footer{...} and footer a{...} rules used to be repeated here too,
  but they're word-for-word identical to rules already in
  assets/common.css — dropped as duplication, not a behavior change.
#}
{% endblock %}

{% block content %}
<div class="py-5">
<div class="container">
  <div class="text-center mb-5">
    <div class="icon-circle mx-auto mb-3">
      <i class="bi {{ locale.content.hero.icon }}"></i>
    </div>
    <h1 class="h5 mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h1>
    <div style="height: 20px;"></div>
  </div>

  {#
    This empty grid is the ONLY gallery-related element Nunjucks
    renders — everything inside it gets built by pageScript at runtime.
  #}
  <div class="row g-4" id="galleryGrid"></div>

  <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 mt-4">
    <div class="small text-secondary">
      {{ locale.content.counterPrefix }} <span id="shownCount">0</span> {{ locale.content.counterSeparator }} <span id="totalCount">0</span>
    </div>
    <button class="btn btn-primary btn-sm px-4" id="loadMoreBtn" type="button">
      {{ locale.content.loadMoreLabel }}
    </button>
  </div>
</div>
</div>

<!-- LIGHTBOX MODAL -->
<div class="modal fade" id="zoomModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered modal-xl">
  <div class="modal-content bg-black border-0 position-relative">
    {#
      Both languages want this close button in the same visual (top
      trailing) corner, but got there via different Bootstrap logical
      classes — "start-0" happens to mean "right" in Arabic's RTL
      context, "end-0" means "right" in English's LTR context. Kept as
      data per language rather than collapsed into one value, since —
      unlike the plain CSS above — these are Bootstrap's own utility
      classes, not a property this template controls directly.
    #}
    <button class="btn-close btn-close-white position-absolute top-0 {{ locale.content.modalCloseButtonPositionClass }} m-3"
            data-bs-dismiss="modal" aria-label="{{ locale.content.modalCloseAriaLabel }}"></button>
    <img id="zoomImage" class="w-100" src="" alt="{{ locale.content.modalImageAlt }}">
  </div>
</div>
</div>

<!-- BACK TO TOP BUTTON -->
<button class="back-to-top" id="backToTop" aria-label="{{ locale.content.backToTopAriaLabel }}">
<i class="bi bi-arrow-up"></i>
</button>
{% endblock %}

{% block pageScript %}
{#
  Lightbox + back-to-top button: unchanged from the original pages,
  no translatable text involved. Copied over as-is.
#}
const zoomModal = document.getElementById('zoomModal');
const zoomImage = document.getElementById('zoomImage');
if (zoomModal && zoomImage) {
  zoomModal.addEventListener('show.bs.modal', (event) => {
    const button = event.relatedTarget;
    if (button) {
      zoomImage.src = button.getAttribute('data-full') || '';
    }
  });
  zoomModal.addEventListener('hidden.bs.modal', () => {
    zoomImage.src = '';
  });
}

const backToTopBtn = document.getElementById('backToTop');
if (backToTopBtn) {
  function checkScroll() {
    const scrollTop = document.body.scrollTop || document.documentElement.scrollTop || window.pageYOffset || 0;
    if (scrollTop > 200) {
      backToTopBtn.classList.add('show');
    } else {
      backToTopBtn.classList.remove('show');
    }
  }

  document.body.addEventListener('scroll', checkScroll, { passive: true });
  window.addEventListener('scroll', checkScroll, { passive: true });
  window.addEventListener('load', checkScroll);
  checkScroll();
  setTimeout(checkScroll, 100);
  setTimeout(checkScroll, 500);
  setInterval(checkScroll, 100);

  backToTopBtn.addEventListener('click', (e) => {
    e.preventDefault();
    document.body.scrollTo({ top: 0, behavior: 'smooth' });
    document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
  });
}

(function () {
  // ----- Gallery image loader (fetches gallery.json, "load more" batches) -----
  const grid = document.getElementById('galleryGrid');
  const btn = document.getElementById('loadMoreBtn');
  const shownEl = document.getElementById('shownCount');
  const totalEl = document.getElementById('totalCount');

  if (!grid || !btn || !shownEl || !totalEl) return;

  const BATCH = 24;
  let files = [];
  let index = 0;

  function updateCounts() {
    shownEl.textContent = String(Math.min(index, files.length));
    totalEl.textContent = String(files.length);
    btn.disabled = index >= files.length;
    // "| safe" here for the same reason documented in contract.njk:
    // this string lands inside a <script> tag, which is never
    // HTML-entity-decoded by the browser.
    btn.textContent = btn.disabled ? '{{ locale.content.allLoadedLabel | safe }}' : '{{ locale.content.loadMoreLabel | safe }}';
  }

  function renderBatch() {
    const slice = files.slice(index, index + BATCH);
    index += slice.length;

    const frag = document.createDocumentFragment();

    slice.forEach((name) => {
      const path = `assets/gallery/${name}`;

      const col = document.createElement('div');
      col.className = 'col-sm-6 col-lg-4';
      col.innerHTML = `
        <div class="gallery-card">
          <div class="gallery-img-wrapper">
            <img
              src="${path}"
              alt="{{ locale.content.imgAlt | safe }}"
              loading="lazy"
              decoding="async"
            >
            <button class="gallery-zoom-icon" type="button"
              data-bs-toggle="modal"
              data-bs-target="#zoomModal"
              data-full="${path}"
              aria-label="{{ locale.content.zoomButtonAriaLabel | safe }}">
              <i class="bi bi-arrows-fullscreen"></i>
            </button>
          </div>
        </div>
      `;

      const img = col.querySelector('img');
      img.addEventListener('error', () => col.remove());

      frag.appendChild(col);
    });

    grid.appendChild(frag);
    updateCounts();
  }

  fetch('gallery.json')
    .then(r => {
      if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`);
      return r.json();
    })
    .then((data) => {
      files = Array.isArray(data) ? data : [];
      index = 0;
      updateCounts();
      renderBatch();
    })
    .catch((error) => {
      console.error('Error loading gallery.json:', error);
      if (grid) {
        grid.innerHTML = '<div class="col-12"><p class="text-center text-danger">{{ locale.content.loadErrorMessage | safe }}</p></div>';
      }
    });

  btn.addEventListener('click', renderBatch);
})();
{% endblock %}
