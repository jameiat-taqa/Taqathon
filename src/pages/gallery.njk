---
pagination:
  data: pages.gallery.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - GALLERY PAGE TEMPLATE (src/pages/gallery.njk)
  -----------------------------------------------------------
  Unlike every other migrated page, almost nothing here is rendered by
  Nunjucks at build time — the actual photo grid is built entirely by
  client-side JavaScript in pageScript below, which fetches gallery.json
  at runtime and renders image cards + a "load more" button + a
  lightbox modal. This template's job is mostly just providing the
  page shell and handing that script the handful of translated strings
  it needs (button labels, alt text, the error message).

  REAL functionality, not placeholder — pageScript is UNCHANGED by
  this redesign (Phase 3, editorial rollout, page 13 — see about.njk
  for the token-system rationale). Only the visual skin changes.

  TO CUSTOMIZE:
    - Text/labels → src/_data/copy/gallery.ar.json / gallery.en.json.
    - Which images appear → gallery.json at the repo root (unchanged by
      this migration — still a flat array of filenames in assets/gallery/).
    - Batch size → the BATCH constant in pageScript below (still 24,
      same as the original).
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.gl-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.gl-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.gl-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.gl-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0; }
[dir="rtl"] .gl-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
[data-bs-theme="dark"] .gl-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .gl-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }

.gl-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }

.gallery-card{
  border:1px solid rgba(0,40,76,.08); border-radius:1rem; overflow:hidden;
  background:#fff; box-shadow:0 10px 30px rgba(15,23,42,.08);
  transition:transform .12s ease, box-shadow .12s ease; height:100%;
}
[data-bs-theme="dark"] .gallery-card{ background:var(--surface); border-color:rgba(255,255,255,.08); }
.gallery-card:hover{ transform:translateY(-4px); box-shadow:0 14px 40px rgba(15,23,42,.16); }
.gallery-img-wrapper{ position:relative; overflow:hidden; aspect-ratio:4/3; background:#000; }
.gallery-img-wrapper img{ width:100%; height:100%; object-fit:cover; transition:.3s ease; }
.gallery-card:hover img{ transform:scale(1.05); }

.gallery-zoom-icon{
  position:absolute; bottom:.9rem; inset-inline-end:.9rem; width:2rem; height:2rem; border-radius:50%;
  background:var(--color-terra); color:var(--color-cream); display:flex; justify-content:center; align-items:center; border:none;
}
[data-bs-theme="dark"] .gallery-zoom-icon{ background:var(--color-amber); color:var(--brand-dark); }

#loadMoreBtn{ background:var(--color-amber); color:var(--brand-dark); border:none; border-radius:.5rem; padding:.5rem 1.5rem; font-weight:700; transition:filter .2s ease, transform .2s ease; }
#loadMoreBtn:hover:not(:disabled){ filter:brightness(1.05); transform:translateY(-1px); }
#loadMoreBtn:active:not(:disabled){ transform:translateY(0); }
#loadMoreBtn:disabled{ background:rgba(0,40,76,.15); color:var(--color-dust); cursor:not-allowed; opacity:.7; }
[data-bs-theme="dark"] #loadMoreBtn:disabled{ background:rgba(255,255,255,.12); color:var(--muted); }

.back-to-top{
  position:fixed; bottom:2rem; inset-inline-end:2rem; width:3rem; height:3rem; border-radius:50%;
  background:var(--brand-dark); color:var(--color-cream); border:none; display:flex; align-items:center; justify-content:center;
  font-size:1.25rem; box-shadow:0 4px 12px rgba(0,0,0,.3); cursor:pointer;
  opacity:0; visibility:hidden; transition:opacity .3s ease, visibility .3s ease, transform .2s ease, filter .2s ease;
  z-index:9999; pointer-events:none;
}
.back-to-top.show{ opacity:1; visibility:visible; pointer-events:auto; }
.back-to-top:hover{ filter:brightness(1.2); transform:translateY(-2px); }
.back-to-top:active{ transform:translateY(0); }
@media (max-width:575.98px){ .back-to-top{ bottom:1.5rem; inset-inline-end:1.5rem; width:2.75rem; height:2.75rem; font-size:1.1rem; } }

.modal-content .btn-close{ z-index:5; }
{% endblock %}

{% block content %}

<section class="gl-hero">
<div class="container">
  <h1 class="gl-display">{{ locale.content.hero.heading }}</h1>
</div>
</section>

<section class="gl-section">
<div class="container">
  <div class="row g-4" id="galleryGrid"></div>

  <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 mt-4">
    <div class="small" style="color:var(--color-dust);">
      {{ locale.content.counterPrefix }} <span id="shownCount">0</span> {{ locale.content.counterSeparator }} <span id="totalCount">0</span>
    </div>
    <button class="btn btn-sm px-4" id="loadMoreBtn" type="button">
      {{ locale.content.loadMoreLabel }}
    </button>
  </div>
</div>
</section>

<!-- LIGHTBOX MODAL -->
<div class="modal fade" id="zoomModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered modal-xl">
  <div class="modal-content bg-black border-0 position-relative">
    <button class="btn-close btn-close-white position-absolute top-0 {{ locale.content.modalCloseButtonPositionClass }} m-3"
            data-bs-dismiss="modal" aria-label="{{ locale.content.modalCloseAriaLabel }}"></button>
    <img id="zoomImage" class="w-100" src="" alt="{{ locale.content.modalImageAlt }}">
  </div>
</div>
</div>

<!-- BACK TO TOP BUTTON -->
<button class="back-to-top" id="backToTop" aria-label="{{ locale.content.backToTopAriaLabel }}">
<i class="bi bi-arrow-up"></i>
</button>
{% endblock %}

{% block pageScript %}
const zoomModal = document.getElementById('zoomModal');
const zoomImage = document.getElementById('zoomImage');
if (zoomModal && zoomImage) {
  zoomModal.addEventListener('show.bs.modal', (event) => {
    const button = event.relatedTarget;
    if (button) {
      zoomImage.src = button.getAttribute('data-full') || '';
    }
  });
  zoomModal.addEventListener('hidden.bs.modal', () => {
    zoomImage.src = '';
  });
}

const backToTopBtn = document.getElementById('backToTop');
if (backToTopBtn) {
  function checkScroll() {
    const scrollTop = document.body.scrollTop || document.documentElement.scrollTop || window.pageYOffset || 0;
    if (scrollTop > 200) {
      backToTopBtn.classList.add('show');
    } else {
      backToTopBtn.classList.remove('show');
    }
  }

  document.body.addEventListener('scroll', checkScroll, { passive: true });
  window.addEventListener('scroll', checkScroll, { passive: true });
  window.addEventListener('load', checkScroll);
  checkScroll();
  setTimeout(checkScroll, 100);
  setTimeout(checkScroll, 500);
  setInterval(checkScroll, 100);

  backToTopBtn.addEventListener('click', (e) => {
    e.preventDefault();
    document.body.scrollTo({ top: 0, behavior: 'smooth' });
    document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
  });
}

(function () {
  const grid = document.getElementById('galleryGrid');
  const btn = document.getElementById('loadMoreBtn');
  const shownEl = document.getElementById('shownCount');
  const totalEl = document.getElementById('totalCount');

  if (!grid || !btn || !shownEl || !totalEl) return;

  const BATCH = 24;
  let files = [];
  let index = 0;

  function updateCounts() {
    shownEl.textContent = String(Math.min(index, files.length));
    totalEl.textContent = String(files.length);
    btn.disabled = index >= files.length;
    btn.textContent = btn.disabled ? '{{ locale.content.allLoadedLabel | safe }}' : '{{ locale.content.loadMoreLabel | safe }}';
  }

  function renderBatch() {
    const slice = files.slice(index, index + BATCH);
    index += slice.length;

    const frag = document.createDocumentFragment();

    slice.forEach((name) => {
      const path = `assets/gallery/${name}`;

      const col = document.createElement('div');
      col.className = 'col-sm-6 col-lg-4';
      col.innerHTML = `
        <div class="gallery-card">
          <div class="gallery-img-wrapper">
            <img
              src="${path}"
              alt="{{ locale.content.imgAlt | safe }}"
              loading="lazy"
              decoding="async"
            >
            <button class="gallery-zoom-icon" type="button"
              data-bs-toggle="modal"
              data-bs-target="#zoomModal"
              data-full="${path}"
              aria-label="{{ locale.content.zoomButtonAriaLabel | safe }}">
              <i class="bi bi-arrows-fullscreen"></i>
            </button>
          </div>
        </div>
      `;

      const img = col.querySelector('img');
      img.addEventListener('error', () => col.remove());

      frag.appendChild(col);
    });

    grid.appendChild(frag);
    updateCounts();
  }

  fetch('gallery.json')
    .then(r => {
      if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`);
      return r.json();
    })
    .then((data) => {
      files = Array.isArray(data) ? data : [];
      index = 0;
      updateCounts();
      renderBatch();
    })
    .catch((error) => {
      console.error('Error loading gallery.json:', error);
      if (grid) {
        grid.innerHTML = '<div class="col-12"><p class="text-center text-danger">{{ locale.content.loadErrorMessage | safe }}</p></div>';
      }
    });

  btn.addEventListener('click', renderBatch);
})();
{% endblock %}
