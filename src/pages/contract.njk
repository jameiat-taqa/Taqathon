---
# Same pagination trick as home.njk — see that file for the full
# explanation. Short version: this runs the template twice, once per
# entry in pages.contract.locales (built in src/_data/pages/contract.js),
# writing /contract.html and /contract-en.html.
pagination:
  data: pages.contract.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - CONTRACT PAGE TEMPLATE (src/pages/contract.njk)
  ------------------------------------------------------------
  Participation agreement page: numbered terms list + a PDF upload form
  that POSTs directly to a Google Apps Script Web App (no server of our
  own involved — see src/_data/config.json for that URL).

  TO CUSTOMIZE:
    - Wording (terms, labels, status messages) → src/_data/copy/contract.ar.json
      and contract.en.json, NOT this file.
    - The Apps Script endpoint the form submits to → src/_data/config.json.
    - Required-field list / validation rules → the pageScript block below
      (this is real client-side JS, not something data-driven).

  FIXED DURING MIGRATION (not just carried over as-is):
    - The original English page's navbar logo linked to "index-EN.html"
      (capital EN) — a typo that 404s on GitHub Pages, which is
      case-sensitive. Fixed automatically here since the navbar partial
      now reads the link from site.en.json, which already had the
      correct lowercase "index-en.html".
    - The original Terms list had a stray, unclosed empty <div> sitting
      right before item 4 in BOTH language versions (browsers silently
      papered over it, but the markup was invalid). Rebuilt below as a
      clean loop over 4 items instead of 4 hand-typed near-duplicate
      blocks.

  DELIBERATELY NOT FIXED (flagged instead, see the "_note_subtext"
  field in contract.ar.json): the Arabic subtext says the name/team/
  email fields ARE required; the English subtext says they're
  OPTIONAL — even though both languages mark those same fields with a
  red required-asterisk. That's a genuine content contradiction in the
  live site already, not something this migration should silently
  "fix" by guessing which version is correct.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.btn-gradient{ background:var(--brand-grad); border:0; color:#fff; }
.icon-circle i{ line-height:1; }

.badge-step{
  display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:999px; font-size:.9rem;
  background:rgba(32,201,151,.15); color:#1b7f61; border:1px solid rgba(32,201,151,.25);
}

{#
  The original Arabic rule used font-weight:700 here; the English one
  used 600. A genuine (if minor) value difference, not just two ways of
  writing the same thing, so it's data-driven rather than picked
  arbitrarily. The margin, on the other hand, is unified to the logical
  "margin-inline-start" for both languages — that single property
  already resolves to the right side in RTL and the left side in LTR,
  which is exactly what the original two separate rules (one using
  margin-inline-start, one using a hardcoded margin-left) were each
  trying to achieve — so no data field needed for that part.
#}
/* Red asterisk for required fields */
.form-label.required::after,
label.required::after{
  content:" *";
  color:#dc3545;
  font-weight:{{ locale.content.requiredAsteriskWeight }};
  margin-inline-start:.15rem;
}
{% endblock %}

{% block content %}
<!-- MAIN -->
<main class="py-5">
  <div class="container" style="max-width:980px;">
    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3"{% if locale.content.hero.iconAriaHidden %} aria-hidden="true"{% endif %}>
        <i class="bi {{ locale.content.hero.icon }}"></i>
      </div>
      <h5 class="mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h5>
      <div style="height: 20px;"></div>
    </div>

    <!-- Terms -->
    <div class="card card-lite rounded-2xl shadow-soft mb-4">
      <div class="card-body">
        <h6 class="mb-3">{{ locale.content.terms.heading }}</h6>
        {#
          Looping with `loop.index` (1-based, built into Nunjucks) gives
          us the "1", "2", "3", "4" badge numbers for free — no need to
          store the number in the data file, and no risk of the badge
          number and the item's position in the list ever drifting out
          of sync the way hand-typed HTML could.
        #}
        {% for item in locale.content.terms.items %}
        <div class="d-flex align-items-start gap-2{% if not loop.last %} mb-2{% endif %}">
          <span class="badge-step"{% if locale.content.terms.badgeAriaHidden %} aria-hidden="true"{% endif %}>{{ loop.index }}</span>
          <div>{{ item }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- Upload Form -->
    <div class="card card-lite rounded-2xl shadow-soft">
      <div class="card-body">
        <h6 class="mb-1">{{ locale.content.form.heading }}</h6>
        <div class="text-secondary mb-3">{{ locale.content.form.subtext }}</div>

        <form id="agreementForm" class="needs-validation" novalidate>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="full_name" class="form-label required">{{ locale.content.form.fullNameLabel }}</label>
              <input class="form-control" id="full_name" name="full_name" placeholder="{{ locale.content.form.fullNamePlaceholder }}">
            </div>
            <div class="col-md-6">
              <label for="team_name" class="form-label required">{{ locale.content.form.teamNameLabel }}</label>
              <input class="form-control" id="team_name" name="team_name" placeholder="{{ locale.content.form.teamNamePlaceholder }}">
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label required">{{ locale.content.form.emailLabel }}</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="{{ locale.content.form.emailPlaceholder }}">
            </div>
            <div class="col-md-6">
              <label for="file" class="form-label required">{{ locale.content.form.fileLabel }}</label>
              <input type="file" accept="application/pdf" class="form-control" id="file" name="file" aria-describedby="fileHelp">
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" value="yes" id="agree" required>
                <label class="form-check-label required" for="agree">
                  {{ locale.content.form.agreeLabel }}
                </label>
              </div>
            </div>
          </div>

          {#
            These hidden fields travel with the form submission so the
            Google Apps Script backend (which receives BOTH languages'
            submissions at the same URL — see config.json) can tell
            which page/language a given submission came from.
          #}
          {#
            This hidden "source" field is cosmetic only — see the big
            comment in contract.en.json's "_comment" field. The submit
            handler below builds its own FormData from scratch and
            never actually reads these hidden inputs' values; it has
            its own separate (and, for English, differently-worded)
            source string. Both are preserved exactly as they were.
          #}
          <!-- Metadata -->
          <input type="hidden" name="locale" value="{{ locale.content.meta.locale }}">
          <input type="hidden" name="source" value="{{ locale.content.meta.hiddenSourceValue }}">

          <div id="status" class="mt-3 d-none" role="alert"></div>

          <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
            <button id="submitBtn" class="btn btn-gradient px-4 py-2 rounded-2xl" type="submit" disabled>
              {{ locale.content.form.submitLabel }}
            </button>
            <a href="assets/docs/Taqathon-Contract.pdf" class="btn btn-outline-secondary rounded-2xl" download>
              <i class="bi bi-download {{ locale.content.form.downloadIconMarginClass }}" aria-hidden="true"></i> {{ locale.content.form.downloadLabel }}
            </a>
          </div>
        </form>

        <div class="alert alert-info mt-3 rounded-2xl" role="alert">
          <div class="fw-semibold mb-1">{{ locale.content.form.notesHeading }}</div>
          <ul class="mb-0">
            {# note1Html / note2Html contain real HTML (a <strong> tag,
               a mailto <a> link) written directly into the data file on
               purpose, so `| safe` tells Nunjucks not to escape it into
               literal "&lt;strong&gt;" text. #}
            <li class="mb-1">{{ locale.content.form.note1Html | safe }}</li>
            <li class="mb-1">{{ locale.content.form.note2Html | safe }}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}

{% block pageScript %}
{#
  This entire block is the same Apps-Script upload handler the original
  pages had, unchanged in BEHAVIOR — the only differences are the
  handful of Nunjucks variable placeholders that pull in per-language
  status text and metadata values, instead of having two near-identical
  script blocks (one per language) hardcoding their own copies of this
  same logic, which is exactly the duplication this whole migration
  exists to remove.
#}
document.addEventListener('DOMContentLoaded', function () {
  // The Apps Script Web App URL both languages submit to — see
  // src/_data/config.json. Filled in here at build time, not
  // hardcoded per page like the original two files did.
  //
  // Every Nunjucks placeholder below inside this script block uses the
  // "| safe" filter. Nunjucks HTML-escapes placeholder output by
  // default (so a literal double-quote in a data file would come out
  // as the HTML entity for a quote mark) — normally correct, since
  // most placeholder output lands in ordinary HTML where that escaping
  // matters. But text sitting inside a script tag is never HTML-entity-
  // decoded by the browser; it's read as raw JavaScript source.
  // Without "| safe" here, any status message that happened to contain
  // a quote character would silently turn into broken-looking escaped
  // text on screen instead of a real quote mark — which is exactly
  // what happened during this page's migration before this fix (see
  // htmlDetectedHint below, which contains literal quotes).
  var SCRIPT_URL = "{{ locale.config.contractScriptUrl | safe }}";

  var form   = document.getElementById('agreementForm');
  var status = document.getElementById('status');
  var btn    = document.getElementById('submitBtn');
  var file   = document.getElementById('file');
  var agree  = document.getElementById('agree');

  function showStatus(kind, html){
    if (!status) return;
    status.className = 'alert alert-' + kind + ' mt-3';
    status.innerHTML = html;
    status.classList.remove('d-none');
  }
  function clearStatus(){ if (status) status.classList.add('d-none'); }

  // Only accepts files whose NAME ends in .pdf — this doesn't inspect
  // the file's actual contents, just its extension. Good enough as a
  // first line of defense; the accept="application/pdf" attribute on
  // the <input> above also hints the OS file picker to filter for PDFs.
  function isPdfSelected(){
    if (!(file && file.files && file.files.length > 0)) return false;
    var f = file.files[0];
    return /\.pdf$/i.test(f.name);
  }

  function updateState() {
    if (!btn) return;
    var ok = isPdfSelected() && agree && agree.checked === true;
    btn.disabled = !ok;
  }

  if (file)  file.addEventListener('input', updateState);
  if (agree) agree.addEventListener('change', updateState);
  document.addEventListener('change', updateState);
  updateState();

  if (!form) return;

  form.addEventListener('submit', function(e){
    e.preventDefault();
    clearStatus();

    if (!isPdfSelected()) { showStatus('warning', '{{ locale.content.status.chooseFile | safe }}'); return; }
    if (!(agree && agree.checked)) { showStatus('warning', '{{ locale.content.status.mustAgree | safe }}'); return; }

    var oldText = btn ? btn.textContent : '';
    if (btn) { btn.disabled = true; btn.textContent = '{{ locale.content.status.submitting | safe }}'; }

    // Google Apps Script's simple HTTP endpoints can't easily receive
    // raw binary file uploads, so the PDF gets converted to a base64
    // text string first (readAsDataURL, then strip the "data:...;base64,"
    // prefix) and sent alongside the normal form fields.
    function fileToBase64(f){
      return new Promise(function(resolve, reject){
        var r = new FileReader();
        r.onload = function(){
          var s = String(r.result || '');
          resolve(s.replace(/^data:.*;base64,/, ''));
        };
        r.onerror = reject;
        r.readAsDataURL(f);
      });
    }

    var fd = new FormData();
    var fullNameEl = document.getElementById('full_name');
    var teamNameEl = document.getElementById('team_name');
    var emailEl    = document.getElementById('email');

    var fullName = fullNameEl && fullNameEl.value ? fullNameEl.value.trim() : '';
    var teamName = teamNameEl && teamNameEl.value ? teamNameEl.value.trim() : '';
    var email    = emailEl    && emailEl.value    ? emailEl.value.trim()    : '';

    if (fullName) fd.append('full_name', fullName);
    if (teamName) fd.append('team_name', teamName);
    if (email)    fd.append('email', email);

    var f = file.files[0];
    fd.append('file', f);

    fileToBase64(f).then(function(b64){
      fd.append('file_b64', b64);
      fd.append('filename', f && f.name ? f.name : 'upload.pdf');
      fd.append('mimeType', f && f.type ? f.type : 'application/pdf');

      fd.append('agree', 'yes');
      fd.append('locale', '{{ locale.content.meta.locale | safe }}');
      // NOTE: this is deliberately NOT the same string as the hidden
      // "source" input above for the English version — see this page's
      // header comment and contract.en.json's "_comment" field. This
      // is the value that actually reaches the Apps Script backend.
      fd.append('source', '{{ locale.content.meta.jsSourceValue | safe }}');

      return fetch(SCRIPT_URL, { method: 'POST', body: fd, redirect: 'follow' });
    })
    .then(function(res){
      return res.text().then(function(t){
        var data = {};
        try { data = JSON.parse(t); } catch(e){}
        return { ok: res.ok, status: res.status, data: data, raw: t };
      });
    })
    .then(function(resp){
      // Apps Script sometimes responds with a Google login/permissions
      // HTML page instead of JSON if the Web App's access isn't set to
      // "Anyone" — this sniffs for that so the error message can hint
      // at the real cause instead of just saying "something went wrong."
      var looksLikeHtml = typeof resp.raw === 'string' && /<html/i.test(resp.raw);
      if (!resp.ok || looksLikeHtml) {
        var hint = looksLikeHtml ? '{{ locale.content.status.htmlDetectedHint | safe }}' : '';
        var msg = (resp.data && resp.data.error) ? resp.data.error : ('{{ locale.content.status.requestFailedPrefix | safe }}' + resp.status + '{{ locale.content.status.requestFailedSuffix | safe }}' + hint);
        showStatus('danger', msg);
        return;
      }

      if (resp.data && resp.data.ok) {
        showStatus('success', '{{ locale.content.status.submitSuccess | safe }}');
        form.reset();
        updateState();
      } else {
        var err = (resp.data && resp.data.error) ? resp.data.error : '{{ locale.content.status.submitFailedGeneric | safe }}';
        showStatus('danger', err);
      }
    })
    .catch(function(err){
      console.error(err);
      // Last resort: some browsers/network setups block reading the
      // response due to CORS even when the request itself succeeded.
      // Retrying with mode: 'no-cors' can still deliver the data to
      // Apps Script even though we can't read a response back from it.
      fetch(SCRIPT_URL, { method: 'POST', body: fd, mode: 'no-cors' })
        .then(function(){
          showStatus('warning', '{{ locale.content.status.noCorsFallback | safe }}');
        })
        .catch(function(){
          showStatus('danger', '{{ locale.content.status.networkError | safe }}');
        });
    })
    .finally(function(){
      if (btn) { btn.textContent = oldText; updateState(); }
    });
  });
});
{% endblock %}
