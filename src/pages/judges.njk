---
pagination:
  data: pages.judges.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - JUDGES/MENTORS PAGE TEMPLATE (src/pages/judges.njk)
  -------------------------------------------------------------------
  A grid of profile cards. No real photos exist yet, so each card
  shows a generic Bootstrap-Icon avatar circle instead of a broken
  <img> — see judges.ar.json / judges.en.json's "_comment" for the
  same reasoning used on the Sponsors page.

  PLACEHOLDER CONTENT (Phase 2, 2026-08-11): every name/role/bio is a
  generic stand-in.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.person-avatar{
  width:64px; height:64px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--brand-grad);
  color:#fff; font-size:1.75rem;
  flex-shrink:0;
}
{% endblock %}

{% block content %}
<main class="py-5">
  <div class="container" style="max-width:980px;">

    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3">
        <i class="bi {{ locale.content.hero.icon }}"></i>
      </div>
      <h5 class="mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h5>
      <p class="text-secondary mb-0">{{ locale.content.hero.intro }}</p>
    </div>

    <div class="row g-4">
      {% for p in locale.content.people %}
      <div class="col-md-6">
        <div class="card card-lite rounded-2xl p-4 d-flex flex-row gap-3 align-items-start">
          <div class="person-avatar"><i class="bi bi-person-fill"></i></div>
          <div>
            <h6 class="fw-semibold mb-1">{{ p.name }}</h6>
            <div class="text-secondary small mb-2">{{ p.role }}</div>
            <p class="mb-0">{{ p.bio }}</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

  </div>
</main>
{% endblock %}
