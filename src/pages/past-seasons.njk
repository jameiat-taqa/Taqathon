---
pagination:
  data: pages.past-seasons.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - PAST SEASONS INDEX PAGE (src/pages/past-seasons.njk)
  --------------------------------------------------------------------
  A fixed AR/EN page pair (same simple shape as contract.njk,
  rules.njk, etc.) — the one part of it that ISN'T fixed is
  locale.years, a list built in src/_data/pages/past-seasons.js by
  scanning whichever Year Archive pages actually exist (src/pages/
  years.njk). Adding a new year archive later makes it show up here
  automatically, no edits needed on this page.
#}
{% extends "layouts/base.njk" %}
{% block content %}
<div class="py-5">
  <div class="container" style="max-width:860px;">

    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3">
        <i class="bi {{ locale.content.hero.icon }}"></i>
      </div>
      <h1 class="h4 {{ locale.content.hero.headingClass }} mb-1">{{ locale.content.hero.heading }}</h1>
      <p class="text-secondary mb-0">{{ locale.content.intro }}</p>
    </div>

    {% if locale.years.length %}
    <div class="list-group">
      {% for y in locale.years %}
      <a href="{{ y.href }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
        <span class="fw-semibold">{{ y.title }}</span>
        <i class="bi bi-arrow-{{ 'left' if locale.dir == 'rtl' else 'right' }}"></i>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="text-center text-secondary">{{ locale.content.emptyText }}</p>
    {% endif %}

  </div>
</div>
{% endblock %}
