---
pagination:
  data: pages.past-seasons.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - PAST SEASONS INDEX PAGE (src/pages/past-seasons.njk)
  --------------------------------------------------------------------
  A fixed AR/EN page pair (same simple shape as contract.njk,
  rules.njk, etc.) — the one part of it that ISN'T fixed is
  locale.years, a list built in src/_data/pages/past-seasons.js by
  scanning whichever Year Archive pages actually exist (src/pages/
  years.njk). Adding a new year archive later makes it show up here
  automatically, no edits needed on this page.

  VISUAL SYSTEM (Phase 3, editorial rollout — see about.njk for the
  token-system rationale). Years render as a numbered index list, the
  same "dossier row" pattern tracks.njk introduced for its own three
  parallel, numbered items — a season index is the same shape.
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.ps-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.ps-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.ps-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.ps-badge{ display:inline-flex; background:rgba(196,64,26,.1); color:var(--color-terra); border:1px solid rgba(196,64,26,.25); padding:.4rem .9rem; border-radius:999px; text-transform:uppercase; letter-spacing:.04em; font-size:.75rem; font-weight:700; margin-bottom:1rem; }
.ps-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0 0 .75rem; }
[dir="rtl"] .ps-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
.ps-hero-intro{ color:var(--color-dust); max-width:46ch; margin:0 auto; }
[data-bs-theme="dark"] .ps-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .ps-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }
[data-bs-theme="dark"] .ps-badge{ background:rgba(232,149,43,.12); color:var(--color-amber); border-color:rgba(232,149,43,.3); }
[data-bs-theme="dark"] .ps-hero-intro{ color:var(--muted); }

.ps-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.ps-section .container{ max-width:700px; }
.ps-list{ display:flex; flex-direction:column; gap:1px; background:rgba(0,40,76,.1); border:1px solid rgba(0,40,76,.1); border-radius:.85rem; overflow:hidden; }
[data-bs-theme="dark"] .ps-list{ background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.08); }
.ps-row{
  background:#fff; display:flex; align-items:center; justify-content:space-between;
  padding:1.25rem 1.5rem; text-decoration:none; color:var(--brand-dark); transition:background .15s ease;
}
.ps-row:hover{ background:rgba(196,64,26,.04); color:var(--brand-dark); }
[data-bs-theme="dark"] .ps-row{ background:var(--surface); color:var(--text); }
[data-bs-theme="dark"] .ps-row:hover{ background:rgba(232,149,43,.08); color:var(--text); }
.ps-row-title{ font-family:var(--font-display); font-weight:700; font-size:1.15rem; }
[dir="rtl"] .ps-row-title{ font-family:'Tajawal', var(--font-display); font-weight:800; }
.ps-row .bi{ color:var(--color-terra); }
[data-bs-theme="dark"] .ps-row .bi{ color:var(--color-amber); }
.ps-empty{ text-align:center; color:var(--color-dust); }
[data-bs-theme="dark"] .ps-empty{ color:var(--muted); }
{% endblock %}

{% block content %}

<section class="ps-hero">
<div class="container">
  <span class="ps-badge"><i class="bi {{ locale.content.hero.icon }}"></i> {{ locale.content.hero.heading }}</span>
  <h1 class="ps-display">{{ locale.content.hero.heading }}</h1>
  <p class="ps-hero-intro">{{ locale.content.intro }}</p>
</div>
</section>

<section class="ps-section">
<div class="container">
  {% if locale.years.length %}
  <div class="ps-list">
    {% for y in locale.years %}
    <a href="{{ y.href }}" class="ps-row">
      <span class="ps-row-title">{{ y.title }}</span>
      <i class="bi bi-arrow-{{ 'left' if locale.dir == 'rtl' else 'right' }}"></i>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <p class="ps-empty">{{ locale.content.emptyText }}</p>
  {% endif %}
</div>
</section>

{% endblock %}
