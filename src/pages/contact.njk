---
pagination:
  data: pages.contact.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - CONTACT PAGE TEMPLATE (src/pages/contact.njk)
  ------------------------------------------------------------
  A message form + contact info + sponsor/supervisor logo panels + an
  embedded Google Map. Sponsor/supervisor entries are data-driven loops
  (see contact.ar.json / contact.en.json), same idea as Schedule's
  table rows.

  UPDATE: the Arabic and English forms used to be genuinely different
  features — English had a honeypot, real client-side validation, a
  disabled-while-sending button, and a mailto: fallback; Arabic had
  none of that, and the two even checked different fields in the
  server's response ("ok" vs "result" === "success"). Per explicit
  direction, Arabic is now brought up to the same full feature set,
  and pageScript below is ONE shared handler instead of two diverging
  {% if locale.lang %} branches. The success-check accepts either
  response shape (see the comment right above `succeeded` in
  pageScript) since this migration still can't verify which one the
  live Apps Script backend actually sends — see contact.ar.json's
  "_comment" field for the full history.

  TO CUSTOMIZE:
    - Wording, sponsor/supervisor entries → the copy JSON files, NOT
      this file.
    - The Apps Script endpoint → src/_data/config.json.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.panel{ background:#fff; border:1px solid #e9eef3; border-radius:12px; }
.panel-header{ font-weight:{{ locale.content.panelHeaderWeight }}; }
.btn-gradient{
  background:var(--brand-grad);
  color:#fff; border:0; font-weight:{{ locale.content.panelHeaderWeight }};
  padding:.65rem 1rem; border-radius:.6rem;
}
.btn-gradient:hover{ filter:brightness(.98); color:#fff; }
.form-text.small-muted{ color:#6c757d; font-size:.85rem; }

.info-list{ list-style:none; padding:0; margin:0; }
.info-item{ display:flex; gap:.6rem; align-items:flex-start; padding:.25rem 0; }
.info-item i{ color:var(--brand-blue); font-size:1.05rem; line-height:1.6; }

.sponsor-logo{
  max-height:70px;
  width:auto;
  object-fit:contain;
}
{% endblock %}

{% block content %}
<div class="py-5">
  <div class="container">
    {#
      Accessibility pass (Phase 3): unlike every other page, Contact has
      no hero section — it jumps straight into the two-column panel
      layout by design, so there was never a natural spot for a visible
      page title, and (unlike the panels below) this page had no h1 at
      all. Rather than add a big visible heading that wasn't part of
      the original design, this one is visually-hidden but still in the
      accessibility tree, so screen-reader users get the same "what
      page am I on" context sighted users get for free from the browser
      tab title and the highlighted nav link. The five panel headings
      below (Send us a message / Contact Info / Supervisors / Supporters
      / Location) are this page's real h2s, promoted from h6 tags with
      a `.h6` utility class added so they keep their original visual
      size — same trick used for every other page's hero heading.
    #}
    <h1 class="visually-hidden">{{ locale.content.pageHeading }}</h1>
    <div class="row g-4">

      <!-- Message form -->
      <div class="col-lg-7">
        <div class="panel shadow-soft p-3 p-md-4">
          <h2 class="h6 panel-header mb-1">{{ locale.content.form.heading }}</h2>
          <p class="text-secondary small mb-3">{{ locale.content.form.subheading }}</p>

          <form id="contactForm" novalidate>
            {% if locale.content.form.hasHoneypot %}
            {# Hidden from sighted users AND screen readers (aria-hidden),
               and never reachable by Tab (tabindex="-1") — a real user
               will never see or fill this in, but a simple bot script
               that blindly fills every input often will. If it's
               non-empty on submit, the JS below silently drops the
               request instead of sending it. #}
            <input type="text" name="hp" id="hp" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true">
            {% endif %}

            <div class="mb-3">
              <label class="form-label" for="contact-name">{{ locale.content.form.nameLabel }}</label>
              <input type="text" class="form-control" id="contact-name" name="name" placeholder="{{ locale.content.form.namePlaceholder }}" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="contact-email">{{ locale.content.form.emailLabel }}</label>
              <input type="email" class="form-control" id="contact-email" name="email" placeholder="{{ locale.content.form.emailPlaceholder }}" required>
              {% if locale.content.form.emailHelperText %}
              <div class="form-text small-muted">{{ locale.content.form.emailHelperText }}</div>
              {% endif %}
            </div>
            <div class="mb-3">
              <label class="form-label" for="contact-subject">{{ locale.content.form.subjectLabel }}</label>
              <input type="text" class="form-control" id="contact-subject" name="subject" placeholder="{{ locale.content.form.subjectPlaceholder }}" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="contact-message">{{ locale.content.form.messageLabel }}</label>
              <textarea class="form-control" id="contact-message" name="message" rows="6" placeholder="{{ locale.content.form.messagePlaceholder }}" required></textarea>
            </div>

            {% if locale.content.form.hasMetadataFields %}
            <input type="hidden" name="locale" value="{{ locale.content.form.metaLocaleValue }}">
            <input type="hidden" name="source" value="{{ locale.content.form.metaSourceValue }}">
            {% endif %}

            <button id="submitBtn" type="submit" class="btn btn-gradient w-100">
              {{ locale.content.form.submitLabel }} <i class="bi bi-send {{ locale.content.form.submitIconMarginClass }}"></i>
            </button>
            <div id="contactAlert" class="alert mt-3 d-none" role="alert"></div>

            {% if locale.content.form.submitHelperHtml %}
            <div class="form-text small-muted mt-2">
              {{ locale.content.form.submitHelperHtml | safe }}
            </div>
            {% endif %}
          </form>
        </div>
      </div>

      <!-- Contact info + sponsors + map -->
      <div class="col-lg-5">
        <div class="panel shadow-soft p-3 p-md-4 mb-3">
          <h2 class="h6 panel-header mb-3">{{ locale.content.contactInfo.heading }}</h2>
          <ul class="info-list">
            {% for item in locale.content.contactInfo.items %}
            <li class="info-item">
              <i class="bi {{ item.icon }}"></i>
              <div><strong>{{ item.label }}</strong> — <a class="link-secondary" href="{{ item.href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.text }}</a></div>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="panel shadow-soft p-3 p-md-4 mb-3">
          <h2 class="h6 panel-header mb-3 text-center">{{ locale.content.supervisors.heading }}</h2>
          <div class="row g-3 justify-content-between align-items-center text-center">
            {% for s in locale.content.supervisors.items %}
            <div class="col-6 col-md-5 d-flex flex-column align-items-center text-center">
              <div style="height:90px; display:flex; align-items:center; justify-content:center;">
                <img src="{{ s.logoSrc }}" alt="{{ s.logoAlt }}" class="img-fluid sponsor-logo">
              </div>
              <div style="min-height:50px; display:flex; align-items:center; justify-content:center; margin-top:0.75rem;">
                <div class="badge rounded-pill px-3 py-2" style="background:#e9f3ff; color:#00284C; font-weight:600;">
                  {{ s.badgeText }}
                </div>
              </div>
              <div class="small text-secondary mt-2" style="min-height:50px; display:flex; align-items:center; justify-content:center;">
                {{ s.orgName }}
              </div>
            </div>
            {% endfor %}
          </div>
        </div>

        <div class="panel shadow-soft p-3 p-md-4 mb-3">
          <h2 class="h6 panel-header mb-3 text-center">{{ locale.content.supporters.heading }}</h2>
          <div class="row g-3 justify-content-evenly align-items-center text-center">
            {% for s in locale.content.supporters.items %}
            <div class="col-6 col-md-3 d-flex flex-column align-items-center">
              <img src="{{ s.logoSrc }}" alt="{{ s.logoAlt }}" class="img-fluid sponsor-logo mb-2">
              <div class="small text-secondary text-center">{{ s.orgName }}</div>
            </div>
            {% endfor %}
          </div>
        </div>

        <div class="panel shadow-soft p-3 p-md-4">
          <h2 class="h6 panel-header mb-2">{{ locale.content.location.heading }}</h2>
          <p class="text-secondary mb-2">
            {{ locale.content.location.addressHtml | safe }}
          </p>
          <iframe
              src="{{ locale.content.location.mapSrc }}"
              width="100%"
              height="160"
              style="border:0; border-radius:8px;"
              allowfullscreen=""
              loading="lazy">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block pageScript %}
{#
  This used to be two entirely separate submit handlers, branched by
  {% if locale.lang == "ar" %} — Arabic's was a much simpler, less
  robust version with no honeypot, no client validation, and no
  mailto fallback. Both languages now share this one handler; only the
  strings differ (via locale.content.status.*), the same pattern every
  other page's pageScript already uses. See contact.ar.json's
  "_comment" field for why this changed and what it replaced.
#}
const form = document.getElementById('contactForm');
const alertBox = document.getElementById('contactAlert');
const CONTACT_SCRIPT_URL = "{{ locale.config.contactScriptUrl | safe }}";
const submitBtn = document.getElementById('submitBtn');

function showAlert(kind, html){
  alertBox.className = 'alert mt-3 alert-' + kind;
  alertBox.innerHTML = html;
  alertBox.classList.remove('d-none');
}
function hideAlert(){ alertBox.classList.add('d-none'); }

function isValidEmail(s){ return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s||'').trim()); }

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  hideAlert();

  const fd = new FormData(form);
  if (fd.get('hp')) { return; } // Honeypot filled in => bot => silently drop

  const name = (fd.get('name')||'').trim();
  const email = (fd.get('email')||'').trim();
  const subject = (fd.get('subject')||'').trim();
  const message = (fd.get('message')||'').trim();

  if (!name || !email || !subject || !message){
    showAlert('warning','{{ locale.content.status.requiredFieldsWarning | safe }}');
    return;
  }
  if (!isValidEmail(email)){
    showAlert('warning','{{ locale.content.status.invalidEmailWarning | safe }}');
    return;
  }

  fd.append('pageUrl', location.href);
  fd.append('userAgent', navigator.userAgent);
  fd.append('ts', new Date().toISOString());

  const oldText = submitBtn.textContent;
  submitBtn.disabled = true;
  submitBtn.textContent = '{{ locale.content.status.sendingLabel | safe }}';

  try{
    const res = await fetch(CONTACT_SCRIPT_URL, { method:'POST', body: fd, redirect:'follow' });
    const text = await res.text();
    let data = {};
    try { data = JSON.parse(text); } catch(e){ /* non-JSON (possibly login page) */ }

    const looksLikeHtml = /<html/i.test(text);
    if (!res.ok || looksLikeHtml){
      const hint = looksLikeHtml ? '{{ locale.content.status.htmlDetectedHint | safe }}' : '';
      const msg = (data && data.error) ? data.error : `{{ locale.content.status.requestFailedPrefix | safe }}${res.status}{{ locale.content.status.requestFailedSuffix | safe }}` + hint;
      showAlert('danger', msg);
      return;
    }

    // Accepts EITHER response shape the Apps Script backend might
    // actually return — { ok: true, ... } or { result: 'success', ... }.
    // The two languages used to check different fields (a leftover from
    // when they were unrelated implementations); rather than guess which
    // one the live backend really sends and risk breaking whichever
    // language guessed wrong, both are treated as success here.
    const succeeded = data && (data.ok === true || data.result === 'success');
    if (succeeded){
      const ticket = data.ticketId ? `{{ locale.content.status.ticketIdLabelHtml | safe }}${data.ticketId}{{ locale.content.status.ticketIdCloseHtml | safe }}` : '';
      showAlert('success', '{{ locale.content.status.successMessage | safe }}' + ticket);
      form.reset();
    } else {
      // BUG FIX: the original had a misplaced closing parenthesis here —
      // "showAlert('danger', (data && data.error) ) ? data.error : '...'"
      // — which closes showAlert's argument list one token too early, so
      // the "? ... : ..." ternary runs AFTER the call, on showAlert's
      // (unused) return value, instead of choosing what to pass IN. In
      // the specific case where the server responds {ok:false} with no
      // error field, that bug would render the literal text "undefined"
      // in the alert box instead of the intended fallback message. Fixed
      // by wrapping the whole ternary as the single argument, which is
      // clearly what was intended.
      showAlert('danger', (data && data.error) ? data.error : '{{ locale.content.status.genericSubmitFailed | safe }}');
    }
  } catch(err){
    console.error(err);
    const mailto = `mailto:info@jameiat-taqa.sa?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\n\n${message}`
    )}`;
    try { window.location.href = mailto; } catch(_) {}
    showAlert('warning','{{ locale.content.status.networkErrorFallback | safe }}');
  } finally {
    submitBtn.textContent = oldText;
    submitBtn.disabled = false;
  }
});
{% endblock %}
