---
pagination:
  data: pages.newsletter.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - NEWSLETTER PAGE TEMPLATE (src/pages/newsletter.njk)
  -------------------------------------------------------------------
  Identical single-card "open link" + "copy link" pattern as
  community.njk — same reasoning, just a signup form link instead of
  a chat link. This redesign mirrors community.njk's visual pass
  exactly (same reasoning, see that file) with an `nl-` class prefix
  instead of `cm-` so both pages' styles stay scoped to their own page.

  PLACEHOLDER CONTENT (still true after this redesign): openHref is
  "#" — no real signup form exists yet. See newsletter.*.json's
  "_comment" field. Layout/visual only.
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.nl-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.nl-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.nl-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.nl-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0 0 .75rem; }
[dir="rtl"] .nl-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
.nl-hero-intro{ color:var(--color-dust); max-width:46ch; margin:0 auto; }
[data-bs-theme="dark"] .nl-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .nl-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }
[data-bs-theme="dark"] .nl-hero-intro{ color:var(--muted); }

.nl-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.nl-section .container{ max-width:760px; }
.nl-card{
  background:#fff; border:1px solid rgba(0,40,76,.08); border-radius:1rem;
  padding:1.75rem 2rem; box-shadow:0 6px 18px rgba(0,0,0,.04);
}
[data-bs-theme="dark"] .nl-card{ background:var(--surface); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.35); }
.nl-card-title{ font-family:var(--font-display); font-weight:700; color:var(--brand-dark); font-size:1.3rem; margin:0; }
[dir="rtl"] .nl-card-title{ font-family:'Tajawal', var(--font-display); font-weight:800; }
[data-bs-theme="dark"] .nl-card-title{ color:var(--text); }
.nl-open-btn{ background:var(--color-amber); border:0; color:var(--brand-dark); font-weight:700; }
.nl-open-btn:hover{ filter:brightness(1.05); color:var(--brand-dark); }
.nl-copy-btn{ border:1px solid rgba(0,40,76,.2); color:var(--brand-dark); background:transparent; }
.nl-copy-btn:hover{ background:rgba(0,40,76,.05); color:var(--brand-dark); }
[data-bs-theme="dark"] .nl-copy-btn{ border-color:rgba(255,255,255,.2); color:var(--text); }
[data-bs-theme="dark"] .nl-copy-btn:hover{ background:rgba(255,255,255,.06); color:var(--text); }
.ed-note{
  background:rgba(196,64,26,.05); border:1px solid rgba(196,64,26,.15); border-radius:.75rem;
  padding:1rem 1.25rem; display:flex; align-items:flex-start; gap:.75rem; color:var(--brand-dark);
}
.ed-note .bi{ color:var(--color-terra); font-size:1.15rem; margin-top:.1rem; flex-shrink:0; }
[data-bs-theme="dark"] .ed-note{ background:rgba(232,149,43,.06); border-color:rgba(232,149,43,.2); color:var(--text); }
[data-bs-theme="dark"] .ed-note .bi{ color:var(--color-amber); }
{% endblock %}

{% block content %}

<section class="nl-hero">
<div class="container">
  <h1 class="nl-display">{{ locale.content.hero.heading }}</h1>
  <p class="nl-hero-intro">{{ locale.content.intro }}</p>
</div>
</section>

<section class="nl-section">
<div class="container">
  <div class="nl-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
      <h2 class="nl-card-title">{{ locale.content.cardTitle }}</h2>
      <div class="d-flex gap-2">
        <a class="btn nl-open-btn" target="_blank" rel="noopener"
           href="{{ locale.content.openHref }}" aria-label="{{ locale.content.openAriaLabel }}">
          <i class="bi {{ locale.content.openIcon }} {{ locale.content.iconMarginClass }}"></i> {{ locale.content.openLabel }}
        </a>
        <button type="button" class="btn nl-copy-btn js-copy-link" data-url="{{ locale.content.openHref }}" aria-label="{{ locale.content.copyAriaLabel }}">
          {{ locale.content.copyButtonLabel }}
        </button>
      </div>
    </div>

    <div class="ed-note">
      <i class="bi bi-info-circle-fill"></i>
      <div>
        <strong class="d-block mb-1">{{ locale.content.noteLabel }}</strong>
        {{ locale.content.noteBodyPrefix }}
        <span class="text-break d-inline-block mt-1" dir="ltr">{{ locale.content.openHref }}</span>
      </div>
    </div>
  </div>
</div>
</section>

{% endblock %}

{% block pageScript %}
document.querySelectorAll('.js-copy-link').forEach(function(btn){
  btn.addEventListener('click', async function(){
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      var original = btn.textContent;
      btn.textContent = '{{ locale.content.copiedLabel | safe }}';
      setTimeout(function(){ btn.textContent = original; }, 1200);
    } catch (e) {
      alert('{{ locale.content.copyErrorMsg | safe }}');
    }
  });
});
{% endblock %}
