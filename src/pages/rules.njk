---
pagination:
  data: pages.rules.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - RULES PAGE TEMPLATE (src/pages/rules.njk)
  ------------------------------------------------------
  A Bootstrap accordion with 10 sections, each rendered from one loop
  over locale.content.sections (see rules.ar.json / rules.en.json)
  instead of 10 hand-typed accordion-item blocks. Each section's ID
  pair (heading-<slug> / collapse-<slug>) is generated here from that
  section's "slug" field, so the data file never has to know or care
  about Bootstrap's accordion ID-linking mechanics.

  "expanded" controls whether a section starts open. Only the first
  section (Judging Criteria) is expanded by default, matching the
  original pages — everything else starts collapsed.

  REAL CONTENT, not placeholder (unlike most of the pages in this
  redesign rollout) — the judging criteria percentages, procedures,
  and resource links are actual site content. This redesign changes
  ONLY the visual skin (same .ed-accordion pattern as faq.njk — see
  that file for the full rationale) — not one word of bodyHtml.

  TO CUSTOMIZE:
    - Add/remove/reorder a section → edit the "sections" array in the
      copy JSON files. Give each section a unique "slug".
    - Section body content → the "bodyHtml" field on that section, in
      the copy JSON files. It's raw HTML on purpose (mixed paragraphs,
      lists, and buttons per section — see the "_comment" field in
      rules.ar.json for why this page doesn't use granular fields the
      way Home/Schedule/Submissions do).
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.ed-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.ed-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.ed-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.ed-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0 0 .75rem; }
[dir="rtl"] .ed-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
.ed-hero-intro{ color:var(--color-dust); max-width:46ch; margin:0 auto; }
[data-bs-theme="dark"] .ed-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .ed-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }
[data-bs-theme="dark"] .ed-hero-intro{ color:var(--muted); }

.ed-accordion-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.ed-accordion-section .container{ max-width:820px; }
.ed-accordion .accordion-item{
  background:#fff; border:1px solid rgba(0,40,76,.08); border-radius:.85rem;
  margin-bottom:.9rem; overflow:hidden; box-shadow:0 6px 18px rgba(0,0,0,.04);
}
[data-bs-theme="dark"] .ed-accordion .accordion-item{ background:var(--surface); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.35); }
.ed-accordion .accordion-button{
  font-family:var(--font-display); font-weight:700; font-size:1.05rem;
  color:var(--brand-dark); background:transparent; box-shadow:none;
}
[dir="rtl"] .ed-accordion .accordion-button{ font-family:'Tajawal', var(--font-display); font-weight:800; }
[data-bs-theme="dark"] .ed-accordion .accordion-button{ color:var(--text); }
.ed-accordion .accordion-button:not(.collapsed){ color:var(--color-terra); background:transparent; }
[data-bs-theme="dark"] .ed-accordion .accordion-button:not(.collapsed){ color:var(--color-amber); }
.ed-accordion .accordion-button:focus{ box-shadow:none; }
.ed-accordion .accordion-body{ color:var(--color-dust); }
[data-bs-theme="dark"] .ed-accordion .accordion-body{ color:var(--muted); }
.ed-accordion .accordion-body a{ color:var(--color-terra); font-weight:600; }
[data-bs-theme="dark"] .ed-accordion .accordion-body a{ color:var(--color-amber); }

{#
  criteria-badge (the "30%"/"25%" etc. weight pills in the Judging
  Criteria section): only rule carried over with a genuinely new
  color rather than a straight token swap. amber-bg + navy text is
  the site's established self-contained pairing (6.23:1, same as
  every button elsewhere in this system) — works identically in both
  themes, no dark-mode override needed.
#}
{% endblock %}

{% block content %}

<section class="ed-hero">
<div class="container">
  <h1 class="ed-display">{{ locale.content.hero.heading }}</h1>
  <p class="ed-hero-intro">{{ locale.content.hero.intro }}</p>
</div>
</section>

<section class="ed-accordion-section">
<div class="container">
  <div class="accordion ed-accordion" id="rulesAccordion">
    {% for s in locale.content.sections %}
    <div class="accordion-item">
      <h2 class="accordion-header" id="heading-{{ s.slug }}">
        <button class="accordion-button{% if not s.expanded %} collapsed{% endif %}" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-{{ s.slug }}"
                aria-expanded="{{ 'true' if s.expanded else 'false' }}"
                aria-controls="collapse-{{ s.slug }}">
          {{ s.heading }}
        </button>
      </h2>
      <div id="collapse-{{ s.slug }}" class="accordion-collapse collapse{% if s.expanded %} show{% endif %}"
           aria-labelledby="heading-{{ s.slug }}" data-bs-parent="#rulesAccordion">
        <div class="accordion-body">
          {{ s.bodyHtml | safe }}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
</section>

{% endblock %}
