---
pagination:
  data: pages.submissions.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - SUBMISSIONS PAGE TEMPLATE (src/pages/submissions.njk)
  --------------------------------------------------------------------
  Two cards — project submission form, promo video form — that are
  otherwise identical in structure. Rendered from ONE loop over
  locale.content.forms (see submissions.ar.json / submissions.en.json)
  instead of two hand-typed, copy-pasted card blocks. Same idea for the
  copy-to-clipboard button: one shared click handler in pageScript below
  instead of two nearly-identical <script> blocks, one per card, like
  the original pages had.

  REAL functionality, not placeholder — these are the actual Google
  Form links participants use. This redesign changes ONLY the visual
  skin (Phase 3, editorial rollout, page 8 — see about.njk for the
  token-system rationale); the loop, the copy-button handler, and
  every href are untouched.

  TO CUSTOMIZE:
    - Add a third form/card → add one more object to the "forms" array
      in the copy JSON files. The loop below and the shared copy-button
      handler both already scale to however many forms exist.
    - Wording → same copy JSON files, NOT this file.
#}
{% extends "layouts/base.njk" %}
{% block pageHead %}
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Tajawal:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}
{% block pageStyle %}
.sb-hero{ background:var(--color-cream); color:var(--brand-dark); padding:4rem 0 3rem; position:relative; overflow:hidden; border-bottom:1px solid rgba(0,40,76,.08); }
.sb-hero::before{ content:""; position:absolute; top:-20%; inset-inline-end:-10%; width:420px; height:420px; background:radial-gradient(circle, rgba(196,64,26,.08), transparent 70%); border-radius:50%; pointer-events:none; z-index:0; }
.sb-hero .container{ position:relative; z-index:1; max-width:760px; text-align:center; }
.sb-display{ font-family:var(--font-display); font-weight:700; font-size:clamp(2.5rem, 6vw, 4rem); line-height:1; letter-spacing:-.01em; margin:0; }
[dir="rtl"] .sb-display{ font-family:'Tajawal', var(--font-display); font-weight:800; letter-spacing:0; }
[data-bs-theme="dark"] .sb-hero{ color:var(--text); border-bottom-color:rgba(255,255,255,.08); }
[data-bs-theme="dark"] .sb-hero::before{ background:radial-gradient(circle, rgba(232,149,43,.10), transparent 70%); }

.sb-section{ background:var(--color-sky); padding:3.5rem 0 4rem; }
.sb-section .container{ max-width:820px; }
.sb-card{
  background:#fff; border:1px solid rgba(0,40,76,.08); border-radius:1rem;
  padding:1.75rem 2rem; box-shadow:0 6px 18px rgba(0,0,0,.04); margin-bottom:1.5rem;
}
.sb-card:last-child{ margin-bottom:0; }
[data-bs-theme="dark"] .sb-card{ background:var(--surface); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.35); }
.sb-card-title{ font-family:var(--font-display); font-weight:700; color:var(--brand-dark); font-size:1.3rem; margin:0; }
[dir="rtl"] .sb-card-title{ font-family:'Tajawal', var(--font-display); font-weight:800; }
[data-bs-theme="dark"] .sb-card-title{ color:var(--text); }
.sb-open-btn{ background:var(--color-amber); border:0; color:var(--brand-dark); font-weight:700; }
.sb-open-btn:hover{ filter:brightness(1.05); color:var(--brand-dark); }
.sb-copy-btn{ border:1px solid rgba(0,40,76,.2); color:var(--brand-dark); background:transparent; }
.sb-copy-btn:hover{ background:rgba(0,40,76,.05); color:var(--brand-dark); }
[data-bs-theme="dark"] .sb-copy-btn{ border-color:rgba(255,255,255,.2); color:var(--text); }
[data-bs-theme="dark"] .sb-copy-btn:hover{ background:rgba(255,255,255,.06); color:var(--text); }
.ed-note{
  background:rgba(196,64,26,.05); border:1px solid rgba(196,64,26,.15); border-radius:.75rem;
  padding:1rem 1.25rem; display:flex; align-items:flex-start; gap:.75rem; color:var(--brand-dark);
}
.ed-note .bi{ color:var(--color-terra); flex-shrink:0; margin-top:.15rem; }
[data-bs-theme="dark"] .ed-note{ background:rgba(232,149,43,.06); border-color:rgba(232,149,43,.2); color:var(--text); }
[data-bs-theme="dark"] .ed-note .bi{ color:var(--color-amber); }
{% endblock %}

{% block content %}

<section class="sb-hero">
<div class="container">
  <h1 class="sb-display">{{ locale.content.hero.heading }}</h1>
</div>
</section>

<section class="sb-section">
<div class="container">
  {% for form in locale.content.forms %}
  <div class="sb-card">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
      <h2 class="sb-card-title">{{ form.cardTitle }}</h2>
      <div class="d-flex gap-2">
        <a class="btn sb-open-btn" target="_blank" rel="noopener"
           href="{{ form.openHref }}" aria-label="{{ form.openAriaLabel }}">
          <i class="bi {{ form.openIcon }} {{ locale.content.iconMarginClass }}"></i> {{ form.openLabel }}
        </a>
        <button type="button" class="btn sb-copy-btn js-copy-link" data-url="{{ form.openHref }}" aria-label="{{ form.copyAriaLabel }}">
          {{ locale.content.copyButtonLabel }}
        </button>
      </div>
    </div>

    <div class="ed-note">
      <i class="bi bi-info-circle-fill"></i>
      <div>
        <strong class="d-block mb-1">{{ locale.content.noteLabel }}</strong>
        {{ locale.content.noteBodyPrefix }}
        <span class="text-break d-inline-block mt-1" dir="ltr">{{ form.openHref }}</span>
      </div>
    </div>

    <noscript>
      <p class="mt-2">{{ form.noscriptText }}
        <a href="{{ form.openHref }}" target="_blank" rel="noopener" dir="ltr">{{ form.openHref }}</a>
      </p>
    </noscript>
  </div>
  {% endfor %}
</div>
</section>

{% endblock %}

{% block pageScript %}
document.querySelectorAll('.js-copy-link').forEach(function(btn){
  btn.addEventListener('click', async function(){
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      var original = btn.textContent;
      btn.textContent = '{{ locale.content.copiedLabel | safe }}';
      setTimeout(function(){ btn.textContent = original; }, 1200);
    } catch (e) {
      alert('{{ locale.content.copyErrorMsg | safe }}');
    }
  });
});
{% endblock %}
