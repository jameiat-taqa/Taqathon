---
pagination:
  data: pages.submissions.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - SUBMISSIONS PAGE TEMPLATE (src/pages/submissions.njk)
  --------------------------------------------------------------------
  Two cards — project submission form, promo video form — that are
  otherwise identical in structure. Rendered from ONE loop over
  locale.content.forms (see submissions.ar.json / submissions.en.json)
  instead of two hand-typed, copy-pasted card blocks. Same idea for the
  copy-to-clipboard button: one shared click handler in pageScript below
  instead of two nearly-identical <script> blocks, one per card, like
  the original pages had.

  TO CUSTOMIZE:
    - Add a third form/card → add one more object to the "forms" array
      in the copy JSON files. The loop below and the shared copy-button
      handler both already scale to however many forms exist.
    - Wording → same copy JSON files, NOT this file.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.card-lite{ padding:0; }
.card-body{ padding:1.75rem 2rem; }
@media (max-width:767.98px){ .card-body{ padding:1.25rem 1.5rem; } }

{#
  The original pages used a physical border-right (Arabic) / border-left
  (English) to put the blue accent stripe on the "start" side of the
  alert box. border-inline-start is the logical-property equivalent —
  it resolves to the right side automatically in RTL and the left side
  in LTR, so one rule now covers both languages instead of two mirrored
  ones (same idea already used for the required-field asterisk's margin
  on the Contract page).
#}
.alert-info{
  background:linear-gradient(135deg, #e7f3ff 0%, #f0f8ff 100%);
  border:1px solid #b8daff;
  border-inline-start:4px solid var(--brand-blue);
  color:#004085;
  border-radius:.75rem;
}
.alert-info a{ color:var(--brand-blue); font-weight:600; }
{% endblock %}

{% block content %}
<main class="py-5">
  <div class="container" style="max-width:980px;">
    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3"><i class="bi {{ locale.content.hero.icon }}"></i></div>
      <h5 class="mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h5>
      <div style="height: 20px;"></div>
    </div>

    {% for form in locale.content.forms %}
    <div class="card card-lite rounded-2xl shadow-soft{% if not loop.first %} mt-4{% endif %}">
      <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
          <h5 class="mb-0 fw-semibold">{{ form.cardTitle }}</h5>
          <div class="d-flex gap-2">
            <a class="btn btn-brand btn-lg" target="_blank" rel="noopener"
               href="{{ form.openHref }}" aria-label="{{ form.openAriaLabel }}">
              <i class="bi {{ form.openIcon }} {{ locale.content.iconMarginClass }}"></i> {{ form.openLabel }}
            </a>
            {#
              data-url carries the link this button copies. The shared
              handler in pageScript reads it back out at click time —
              see that block for why this is worth doing instead of a
              separate hardcoded handler per button.
            #}
            <button type="button" class="btn btn-outline-secondary btn-lg js-copy-link" data-url="{{ form.openHref }}" aria-label="{{ form.copyAriaLabel }}">
              {{ locale.content.copyButtonLabel }}
            </button>
          </div>
        </div>

        <div class="alert alert-info fs-6 p-4 mb-0 d-flex align-items-start gap-3">
          <i class="bi bi-info-circle fs-5 mt-1 flex-shrink-0" style="color:var(--brand-blue);"></i>
          <div>
            <strong class="d-block mb-1">{{ locale.content.noteLabel }}</strong>
            {{ locale.content.noteBodyPrefix }}
            <span class="text-break d-inline-block mt-1" dir="ltr">{{ form.openHref }}</span>
          </div>
        </div>

        <noscript>
          <p class="mt-2">{{ form.noscriptText }}
            <a href="{{ form.openHref }}" target="_blank" rel="noopener" dir="ltr">{{ form.openHref }}</a>
          </p>
        </noscript>
      </div>
    </div>
    {% endfor %}
  </div>
</main>
{% endblock %}

{% block pageScript %}
{#
  ONE handler attached to every .js-copy-link button, instead of a
  separate copy of this same logic per button like the original pages
  had. Each button carries its own URL via data-url (set above in the
  content block), so this scales to however many form cards exist
  without needing any changes here.
#}
document.querySelectorAll('.js-copy-link').forEach(function(btn){
  btn.addEventListener('click', async function(){
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      var original = btn.textContent;
      btn.textContent = '{{ locale.content.copiedLabel | safe }}';
      setTimeout(function(){ btn.textContent = original; }, 1200);
    } catch (e) {
      // Older browsers / non-HTTPS contexts can lack the Clipboard API.
      alert('{{ locale.content.copyErrorMsg | safe }}');
    }
  });
});
{% endblock %}
