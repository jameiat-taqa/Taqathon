---
pagination:
  data: pages.sponsors.locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
{#
  TAQATHON - SPONSORS PAGE TEMPLATE (src/pages/sponsors.njk)
  -------------------------------------------------------------
  One section per tier, one plain named box per sponsor within it —
  see sponsors.ar.json / sponsors.en.json's "_comment" for why this
  renders text boxes instead of <img> logos (no real logo files exist
  yet; a broken-image icon would look worse than a clean placeholder).
  Once real logos exist, add a "logo" path per sponsor and swap the
  box's text for an <img src="{{ s.logo }}">.

  PLACEHOLDER CONTENT (Phase 2, 2026-08-11): tier names and every
  sponsor name are generic stand-ins.
#}
{% extends "layouts/base.njk" %}
{% block pageStyle %}
.sponsor-box{
  border:1px dashed rgba(15,23,42,.18);
  border-radius:1rem;
  padding:1.25rem 1rem;
  text-align:center;
  color:var(--text);
  font-weight:600;
  background:#fff;
}
{% endblock %}

{% block content %}
<main class="py-5">
  <div class="container" style="max-width:980px;">

    <div class="text-center mb-4">
      <div class="icon-circle mx-auto mb-3">
        <i class="bi {{ locale.content.hero.icon }}"></i>
      </div>
      <h5 class="mb-1 {{ locale.content.hero.headingClass }}">{{ locale.content.hero.heading }}</h5>
      <p class="text-secondary mb-0">{{ locale.content.hero.intro }}</p>
    </div>

    {% for tier in locale.content.tiers %}
    <div class="mb-4">
      <h6 class="fw-semibold text-secondary mb-3">{{ tier.tierName }}</h6>
      <div class="row g-3">
        {% for s in tier.sponsors %}
        <div class="col-sm-6 col-md-4">
          <div class="sponsor-box">{{ s.name }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}

  </div>
</main>
{% endblock %}
